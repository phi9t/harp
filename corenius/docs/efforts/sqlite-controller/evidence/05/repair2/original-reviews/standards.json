  "findings": [
    {
      "id": "STD05-007",
      "severity": "P2",
      "title": "Return a native start response after history reconciliation",
      "path": "crates/sqlite-controller/src/native_ui.rs",
      "line": 402,
      "related_locations": [
        {
          "path": "crates/sqlite-controller/src/native_ui.rs",
          "line": 405
        },
        {
          "path": "crates/sqlite-controller/src/codex.rs",
          "line": 1353
        }
      ],
      "requirement": "SPEC.md:58,78 and ticket05:12,21 require compatible native controls and durable visible dispositions after lost acknowledgement/reconciliation.",
      "behavior": "A saved codex_turn whose lost start acknowledgement is reconciled from typed native history is confirmed with internal {turn_id,thread_id,...} observation. ui_input returns it unchanged as successful turn/start response. The native consumer expects {turn:{id,...}}; turn is absent despite the confirmed accepted turn.",
      "evidence": "Actual ui_input caller on real SQLite prepares the retained operation; actual reconcile_turn_ack confirms the exact operation/client ID/text from typed history. Exact retry returns internal observation with turn_id=accepted-turn and no turn object; operation count remains one. A normal native-shaped acknowledgement is returned correctly, and changed arguments are refused.",
      "fixture_limit": "Qualified owned binding and declared lost-ACK/history fixture; native drain held by existing fault-injection flag. No native subprocess or wire consumer was used for this edge discriminator.",
      "action": "Normalize reconciled saved-start observations into the same version-pinned native turn/start response as an observed acknowledgement, preserving accepted turn identity and saved command semantics.",
      "log": "independent-edge-probes.log",
      "marker": "EDGE_HISTORY_UI_RESPONSE"
    },
    {
      "id": "STD05-008",
      "severity": "P2",
      "title": "Replay an exact retained steer after the current turn advances",
      "path": "crates/sqlite-controller/src/native_ui.rs",
      "line": 305,
      "related_locations": [
        {
          "path": "crates/sqlite-controller/src/native_ui.rs",
          "line": 308
        }
      ],
      "requirement": "SPEC.md:30,46,58,78 and ticket05:21 require stable retained retries and reconciliation while checking current authority; a new stale request must still be refused.",
      "behavior": "The expectedTurnId/current-turn guard runs before saved control_ui_commands lookup. An already admitted, confirmed steer with unchanged stable ID/arguments and unchanged actor/binding/epoch cannot return its retained receipt after a later turn becomes current.",
      "evidence": "Actual ui_input prepares one codex_steer. Exact retry with retained native response succeeds before advancement; after current_turn and turn_id advance it fails native UI expected turn mismatch. No second operation is created. A fresh stale request is independently refused as expected.",
      "fixture_limit": "Real controller command/receipt/caller with qualified owned binding and declared confirmed observation/turn advancement. No native subprocess used for this edge discriminator.",
      "action": "Validate saved identity/arguments/current authority and replay admitted work before applying current-turn admission checks to new requests. Keep fresh stale, foreign, superseded, and changed-argument refusals.",
      "log": "independent-edge-probes.log",
      "marker": "EDGE_RETAINED_STEER_REPLAY"
    },
    {
      "id": "STD05-009",
      "severity": "P2",
      "title": "Bound the control-center question projection to its shared transport",
      "path": "crates/sqlite-controller/src/control.rs",
      "line": 354,
      "related_locations": [
        {
          "path": "crates/sqlite-controller/src/control.rs",
          "line": 356
        },
        {
          "path": "crates/sqlite-controller/src/client.rs",
          "line": 36
        },
        {
          "path": "crates/sqlite-controller/src/service.rs",
          "line": 154
        }
      ],
      "requirement": "SPEC.md:32,58,80 and ticket05:12,20 require usable shared dashboard/lead projections, retained large text, questions and uncertainty.",
      "behavior": "control_center selects every question including full text/answer without a result budget. Valid retained questions accumulate past the shared 4 MiB client response limit, making the whole dashboard and gateway projection unavailable.",
      "evidence": "Public Controller.handle created one small plus 70 valid 65,536-byte questions in on-disk SQLite. Actual framed response is 4,606,124 bytes versus 4,194,304-byte limit. Actual service::serve_request and client::call over owned Unix sockets return controller response bound/framing for dashboard transport and gateway corenius_query. Small projection succeeds and single question_input retrieves all 65,536 bytes.",
      "fixture_limit": "Actual product service/client/controller/gateway functions and owned Unix sockets; no browser or separate MCP subprocess was needed to establish the shared transport failure.",
      "action": "Return bounded question descriptors/references or pagination with explicit continuation/availability; keep exact full text available via question_input. Account for all projection fields within the shared response budget.",
      "log": "independent-edge-probes.log",
      "marker": "EDGE_CONTROL_CENTER_RESPONSE_BOUND"
    }
  ],
