+            "episodes",
+            "/resources/episodes",
+            json!(4),
+            "budget_exhausted",
+        ),
+        (
+            "repairs",
+            "/resources/repairs",
+            json!(2),
+            "budget_exhausted",
+        ),
+        (
+            "execution_seconds",
