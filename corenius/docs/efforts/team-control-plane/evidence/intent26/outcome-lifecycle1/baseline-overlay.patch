+async fn original_attempt_unknown_effect(api: &Api) -> Uuid {
+    use team_control_plane::gateway::*;
+    let gateway = Gateway::new(api.fixture.broker.clone());
+    let identity = RuntimeIdentity {
+        runtime_kind: "fault".into(),
+        runtime_version: "v1".into(),
+        deployment: "fixture".into(),
+        thread_store: format!("original-attempt-{}", api.fixture.attempt),
+        endpoint: "local".into(),
+        environment: "disposable".into(),
+    };
+    let directory = api.fixture.root.join("controlled-synthetic-effect");
+    std::fs::create_dir(&directory).unwrap();
+    let mut runtime = gateway_fault::FaultRuntime::new(
+        directory.clone(),
+        gateway_fault::Fault::DropReply,
+        identity.clone(),
+    );
+    let binding = Uuid::new_v4();
+    gateway
+        .bind(
+            &api.fixture.owner,
+            binding,
+            api.fixture.admission,
+            &identity,
+            Some("original-thread"),
+            1,
+        )
+        .await
+        .unwrap();
+    let intent = Intent {
+        id: Uuid::new_v4(),
+        admission_id: api.fixture.admission,
+        binding_id: binding,
+        generation: 1,
+        kind: OperationKind::Start,
+        arguments: json!({"prompt":"controlled synthetic file effect only"}),
+    };
+    let prepared = gateway
+        .prepare(&api.fixture.owner, intent.clone())
+        .await
+        .unwrap();
+    let unknown = gateway
+        .dispatch(&api.fixture.owner, intent.id, &mut runtime)
+        .await
+        .unwrap();
+    assert_eq!(unknown.state, OperationState::OutcomeUnknown);
+    assert_eq!(runtime.invocation_count().unwrap(), 1);
+    assert_eq!(runtime.effect_count().unwrap(), 1);
+    let bytes:Vec<_>=std::fs::read_dir(directory).unwrap().map(|p| {let p=p.unwrap().path();json!({"name":p.file_name().unwrap().to_str().unwrap(),"bytes":std::fs::read(p).unwrap()})}).collect();
+    println!(
+        "controlled_synthetic_effect {}",
+        json!({"fixture":"existing support/gateway_fault.rs FaultRuntime::DropReply","kind":"controlled local Python file effect; no provider or shutdown inference","attempt":api.fixture.attempt,"prepared":prepared,"journal":gateway.read(&api.fixture.owner,intent.id).await.unwrap(),"files":bytes,"invocations":1,"effects":1})
+    );
+    intent.id
+}
