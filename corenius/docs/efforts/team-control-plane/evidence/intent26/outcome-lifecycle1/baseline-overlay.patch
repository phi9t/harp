+        let replacement = json!({"schema_version":1,"key":"activate-plan-lead","recovery_epoch":api.fixture.epoch,"command":{"kind":"replace_lead","mission":api.fixture.mission,"expected_generation":0,"credential_id":Uuid::new_v4(),"principal":api.fixture.lead,"token_hash":token_hash("plan-lead"),"expires_in_seconds":300}});
+        let result = api
+            .client
+            .post(format!("{}/v1/mailbox/commands", api.url))
+            .bearer_auth(&api.fixture.owner)
+            .json(&replacement)
+            .send()
+            .await
+            .unwrap();
+        assert_eq!(result.status().as_u16(), 200);
+        let delegation = api.command("plan-authority",1,json!({"kind":"delegation.admit","delegation":{"id":Uuid::new_v4(),"principal":api.fixture.lead,"role_epoch":1,"work":original["command"]["work"],"families":["intent.admit","plan.admit"],"effects":["read","write"],"max_intents":4,"max_plans":8,"resources":{"attempts":8,"episodes":8,"repairs":3,"execution_seconds":30},"expires_in_seconds":300}}));
+        assert_eq!(api.post(&api.fixture.owner, &delegation).await.0, 200);
+        let plan = json!({"schema_version":1,"interpreter_version":"declarative-v1","intent":intent.1["intent"],"acceptance":intent.1["acceptance"],"allowed_effects":["read"],"resources":{"attempts":3,"episodes":3,"repairs":2,"execution_seconds":10},"max_repairs":1,"steps":[{"id":"inspect","kind":"action","depends_on":[],"join":"all","effects":["read"],"max_iterations":1}]});
+        let mut plan = plan;
