+    /// A replacement registration does not acquire an already-owned store.
+    pub async fn register_runtime(
+        &self,
+        service_bearer: &str,
+        runtime: &dyn EpisodeRuntime,
+    ) -> Result<()> {
+        let mut c = storage::client(&self.broker.dsn).await?;
