+    pub(crate) async fn dispatch_guarded(
+        &self,
+        service_bearer: &str,
+        id: Uuid,
+        runtime: &mut dyn EpisodeRuntime,
+        workflow: Option<&crate::temporal::WorkflowRef>,
+    ) -> Result<EpisodeOperation> {
