+                    'mission',t.mission_id,'task',a.task_id,'attempt',a.id,
+                    'admission',o.admission_id,'binding',o.binding_id,'kind',o.kind,
+                    'state',o.state,'thread_id',b.thread_id,'usage',o.usage,
+                    'capacity_held',EXISTS(SELECT 1 FROM reservations z WHERE z.attempt_id=a.id AND z.state='reserved')) AS record
+                FROM gateway_operations o
+                JOIN attempts a ON a.id=o.attempt_id
+                JOIN tasks t ON t.id=a.task_id
+                JOIN gateway_bindings b ON b.id=o.binding_id
+                WHERE ($1 OR (t.mission_id=$2 AND ($3::uuid IS NULL OR a.task_id=$3) AND a.worker_id=$4))
+                  AND (o.state IN ('prepared','dispatching','outcome_unknown','quarantined')
+                    OR (o.state IN ('confirmed','failed_known') AND COALESCE(o.usage->>'kind','unknown')<>'measured_zero'))
+            ) unresolved ORDER BY id,protocol LIMIT 33",
+            &[&owner,&actor.mission,&actor.task,&actor.principal],
+        ).await?;
+        let more_operations = operation_rows.len() > 32;
+        let unresolved_operations: Vec<Value> = operation_rows
+            .into_iter()
+            .take(32)
+            .map(|r| r.get(0))
+            .collect();
+        let snapshot_time: String = tx
+            .query_one("SELECT clock_timestamp()::text", &[])
+            .await?
+            .get(0);
+        let result = json!({"schema_version":1,"snapshot_time":snapshot_time,"recovery_epoch":self.broker.epoch,"missions":missions,"more_missions":more,"executions":executions,"more_executions":more_executions,"unresolved_operations":unresolved_operations,"more_operations":more_operations});
+        tx.commit().await?;
+        Ok(result)
+    }
+}
