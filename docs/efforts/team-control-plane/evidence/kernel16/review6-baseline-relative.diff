+// Terminal tasks retain inspection/release authority but cannot dispatch work.
+pub(crate) async fn execution_dispatch_current(
+    tx: &Transaction<'_>,
+    id: Uuid,
+    epoch: Uuid,
+) -> Result<bool> {
+    if !execution_current(tx, id, epoch).await? {
+        return Ok(false);
