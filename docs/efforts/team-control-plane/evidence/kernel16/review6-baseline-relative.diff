+struct SupervisedRuntime {
+    root: PathBuf,
+    identity: RuntimeIdentity,
+    dsn: String,
+    epoch: Uuid,
+    bearer: String,
+    workspaces: PathBuf,
+    drop_start_reply: bool,
+    unmeasured_start: bool,
