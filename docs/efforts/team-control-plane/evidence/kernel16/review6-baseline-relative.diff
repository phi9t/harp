+    pub admission: Uuid,
+    pub base: String,
+    pub spec: String,
+    admin: tokio_postgres::Client,
+    schema: String,
+}
+impl Fixture {
+    pub async fn new() -> Self {
+        Self::with_requirement(true).await
+    }
