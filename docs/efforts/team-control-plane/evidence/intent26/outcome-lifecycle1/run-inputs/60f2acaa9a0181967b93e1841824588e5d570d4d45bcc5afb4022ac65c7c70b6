    );
    let revalidated = api.post(&api.fixture.owner, &revalidate).await;
    assert_eq!(
        revalidated.0, 200,
        "explicit exact revalidation: {}",
        revalidated.1
    );
    let mut grant = grant;
    grant["key"] = json!("current-grant");
    let response = api
        .client
        .post(format!("{}/v1/commands", api.url))
        .bearer_auth(&api.fixture.owner)
        .json(&grant)
        .send()
        .await
        .unwrap();
    assert_eq!(
        response.status().as_u16(),
        200,
        "current dependency control"
    );
    let receipt: Value = response.json().await.unwrap();
    let attempt = receipt["attempt_id"].clone();
    let supervisor = api.fixture.supervisor().await;
    kernel::Kernel::new(api.fixture.broker.clone())
        .require_supervised_verification(&api.fixture.owner, dependent)
        .await
        .unwrap();
    let gateway = episode_runtime::EpisodeGateway::new(api.fixture.broker.clone());
    let mut prepared_starts = vec![];
    for key in ["start"] {
        let input = Uuid::new_v4();
        let episode = Uuid::new_v4();
        let capture = json!({"schema_version":1,"key":format!("{key}-input"),"recovery_epoch":api.fixture.epoch,"command":{"kind":"capture_input","mission":api.fixture.mission,"id":input,"attempt":attempt,"purpose":"implementation","limit":4}});
        let response = api
            .client
            .post(format!("{}/v1/mailbox/commands", api.url))
            .bearer_auth("dependent-worker")
            .json(&capture)
            .send()
            .await
            .unwrap();
        assert_eq!(response.status().as_u16(), 200);
        let packet: Value = api
            .client
            .get(format!("{}/v1/mailbox/records/input/{input}", api.url))
            .bearer_auth("dependent-worker")
            .send()
            .await
            .unwrap()
            .json()
            .await
            .unwrap();
        let admission = json!({"schema_version":1,"key":format!("{key}-episode"),"recovery_epoch":api.fixture.epoch,"command":{"kind":"admit_episode","mission":api.fixture.mission,"id":episode,"attempt":attempt,"purpose":"implementation","input_packet":input,"input_digest":packet["digest"]}});
