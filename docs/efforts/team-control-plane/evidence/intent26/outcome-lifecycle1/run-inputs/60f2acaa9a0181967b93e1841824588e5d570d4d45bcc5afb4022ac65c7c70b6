async fn measured_acceptance_case(
    mapped_before_verification: bool,
    later_failure: bool,
    amendment: Option<AmendmentCase>,
) {
    use team_control_plane::*;
    let api = Api::measured().await;
    println!(
        "measured_fixture {}",
        json!({"root":api.fixture.root,"task":api.fixture.task,"epoch":api.fixture.epoch})
    );
    let command = vec![
        "/bin/sh",
        "-c",
        "test \"$(cat src/result)\" = 'exact result' && printf 'independent gate\\n'",
    ];
    let mut request = api.admission("production-intent", 0);
    request["command"]["intent"]["acceptance"]["mandatory_commands"] = json!([command]);
    let admitted = if mapped_before_verification {
        let admitted = api.post(&api.fixture.owner, &request).await;
        assert_eq!(admitted.0, 200);
        admitted.1
    } else {
        Value::Null
    };
    api.artifact(&api.fixture.owner,"policy",json!({"kind":"configure","verifier":api.fixture.verifier,"lead_acceptance":true,"base":api.fixture.base,"suite":request["command"]["intent"]["acceptance"]["suite"],"environment":request["command"]["intent"]["acceptance"]["environment"],"mandatory_commands":[command]})).await;
    let store = api.fixture.root.join("store");
    std::fs::write(store.join("src/result"), b"exact result\n").unwrap();
    assembled::git(&store, &["add", "src/result"]);
    assembled::git(
        &store,
        &[
            "-c",
            "user.name=Fixture",
            "-c",
            "user.email=fixture@example.invalid",
            "commit",
            "-qm",
            "candidate",
        ],
    );
    let commit = assembled::git(&store, &["rev-parse", "HEAD"]);
    let tree = assembled::git(&store, &["rev-parse", "HEAD^{tree}"]);
    let bundle = api.fixture.root.join("candidate.bundle");
    assembled::git(
        &store,
        &["bundle", "create", bundle.to_str().unwrap(), "HEAD"],
    );
    let artifact = api
        .upload("assembled-worker", &std::fs::read(bundle).unwrap())
        .await;
    let candidate = json!({"commit":commit,"tree":tree,"base":api.fixture.base,"spec_digest":api.fixture.spec,"spec_revision":2,"generation":1,"artifact":artifact,"deliverables":["src/result"],"risks":[]});
    let submitted = api
        .artifact(
            "assembled-worker",
            "candidate",
            json!({"kind":"submit","candidate":candidate}),
        )
        .await;
    let input = Uuid::new_v4();
    let episode = Uuid::new_v4();
    let mailbox = mailbox::MailboxService::new(api.fixture.broker.clone());
    mailbox.execute("assembled-verifier",assembled::mail(api.fixture.epoch,"capture-verifier",json!({"kind":"capture_input","mission":api.fixture.mission,"id":input,"attempt":api.fixture.attempt,"purpose":"verification","limit":4}))).await.unwrap();
    let packet = mailbox
        .record("assembled-verifier", mailbox::RecordKind::Input, input)
        .await
        .unwrap();
    mailbox.execute("assembled-verifier",assembled::mail(api.fixture.epoch,"admit-verifier",json!({"kind":"admit_episode","mission":api.fixture.mission,"id":episode,"attempt":api.fixture.attempt,"purpose":"verification","input_packet":input,"input_digest":packet["digest"]}))).await.unwrap();
    let bound = if mapped_before_verification {
        let binding=api.command("bind-fresh-verifier",1,json!({"kind":"verification.bind","episode":episode,"intent":admitted["intent"],"acceptance":admitted["acceptance"],"policy":"suite-v2","environment":request["command"]["intent"]["acceptance"]["environment"]}));
        let bound = api.post("assembled-verifier", &binding).await;
        assert_eq!(bound.0, 200, "exact binding before execution: {}", bound.1);
        bound.1
    } else {
        Value::Null
    };
    let service = artifacts::ArtifactService::open(
        api.fixture.broker.clone(),
        &api.fixture.root.join("artifacts"),
    )
    .await
    .unwrap();
    let supervisor = api.fixture.supervisor().await;
    let execution = supervisor
        .create_episode_from_candidate(
            "assembled-verifier",
            episode,
            &service,
            supervisor::CreateFault::None,
        )
        .await
        .unwrap();
    supervisor
        .start(
            "assembled-verifier",
            execution.id,
            command.iter().map(|s| s.to_string()).collect(),
            10,
        )
        .await
        .unwrap();
    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
    let measured = loop {
        if let Some(result) = supervisor
            .result("assembled-verifier", execution.id)
            .await
            .unwrap()
        {
            break result;
        }
        assert!(std::time::Instant::now() < deadline);
        tokio::time::sleep(std::time::Duration::from_millis(20)).await;
    };
    println!(
        "independent_measured_subject {}",
        json!({"binding":bound,"candidate":candidate,"measured_result":measured})
    );
    assert_eq!(measured.exit_code, Some(0));
    assert!(measured.namespace_stopped);
    let view = supervisor
        .inspect("assembled-verifier", execution.id)
        .await
        .unwrap();
    let output = std::fs::read(&view.manifest.log_path).unwrap();
    assert_eq!(output, b"independent gate\n");
    let evidence = serde_json::to_vec(
        &json!({"trusted_monitor_result":measured,"output":String::from_utf8(output).unwrap()}),
    )
    .unwrap();
    let logs = api.upload("assembled-verifier", &evidence).await;
    println!(
        "measured_gate_bytes {}",
        json!({"execution":execution.id,"logs":logs,"artifact_bytes":evidence})
    );
    let pass = json!({"kind":"verify","verification":{"candidate":candidate,"suite":request["command"]["intent"]["acceptance"]["suite"],"environment":request["command"]["intent"]["acceptance"]["environment"],"checks":[{"command":command,"exit_code":0,"logs":logs}],"resolved_decisions":true}});
    let initial_verify = api
        .artifact_request("measured-verification", pass.clone())
        .await;
    let initial_verified = api
        .artifact_response("assembled-verifier", &initial_verify)
        .await;
    assert_eq!(initial_verified.0, 200);
    let verified = initial_verified.1.clone();
    let unresolved_operation = if amendment == Some(AmendmentCase::UnresolvedEffect) {
        // Historical release is valid at this instant. A later independently
        // journaled effect on this exact Attempt must fence retirement.
        supervisor
            .release("assembled-verifier", execution.id)
            .await
            .unwrap();
        Some(original_attempt_unknown_effect(&api).await)
    } else {
        None
    };
    let legacy = api.artifact_request("legacy-accept",json!({"kind":"accept","candidate_id":submitted["candidate_id"],"report_id":verified["report_id"]})).await;
    if !mapped_before_verification {
        let accepted = api.artifact_response(&api.fixture.owner, &legacy).await;
        assert_eq!(accepted.0, 200, "unmapped legacy acceptance remains valid");
        assert_eq!(accepted.1["accepted"], true);
        let historical = service
            .snapshot(&api.fixture.owner, api.fixture.task)
            .await
            .unwrap();
        assert_eq!(historical.status, "accepted");
        let mapped = api.post(&api.fixture.owner, &request).await;
        assert_eq!(mapped.0, 200);
        assert_eq!(
            api.artifact_response(&api.fixture.owner, &legacy).await,
            accepted,
            "mapping retains exact historical v1 receipt"
        );
        let retained = service
            .snapshot(&api.fixture.owner, api.fixture.task)
            .await
            .unwrap();
        assert_eq!(retained.candidate_id, historical.candidate_id);
        assert_eq!(
            serde_json::to_value(retained.reports).unwrap(),
            serde_json::to_value(historical.reports).unwrap()
        );
        assert_eq!(
            api.snapshot().await["accepted"],
            json!([]),
            "old v1 acceptance creates no v2 subject"
        );
        let late=api.command("historical-pass-cannot-rebind",1,json!({"kind":"verification.bind","episode":episode,"intent":mapped.1["intent"],"acceptance":mapped.1["acceptance"],"policy":"suite-v2","environment":request["command"]["intent"]["acceptance"]["environment"]}));
        assert_eq!(
            api.post("assembled-verifier", &late).await.1["code"],
            "dependency_unmet"
        );
        supervisor
            .release("assembled-verifier", execution.id)
            .await
            .unwrap();
        if amendment.is_some() {
            let completed =
                amended_production_case(&api, &request, &command, episode, unresolved_operation)
                    .await;
            let owned_root = api.fixture.root.clone();
            api.finish().await;
            println!(
                "measured_fixture_cleanup {}",
                json!({"root":owned_root,"root_exists":owned_root.exists(),"fixture_finish":!owned_root.exists(),"namespace_stopped":measured.namespace_stopped,"released_executions":[execution.id]})
            );
            assert_eq!(
                completed.0, 200,
                "explicit Owner later work after historical mapping requires fresh execution: {}",
                completed.1
            );
        } else {
            api.finish().await;
        }
        return;
    }
    for token in ["assembled-lead", &api.fixture.owner] {
        let rejected = api.artifact_response(token, &legacy).await;
        assert_eq!(
            rejected.0, 409,
            "mapped legacy Accept must not bypass current v2 acceptance or delegation: {}",
            rejected.1
        );
        assert_eq!(rejected.1["code"], "dependency_unmet");
    }
    assert_eq!(
        service
            .snapshot(&api.fixture.owner, api.fixture.task)
            .await
            .unwrap()
            .status,
        "verifying"
    );
    let proof=api.command("exact-production-proof",2,json!({"kind":"production.verify","binding":bound["binding"],"candidate":submitted["candidate_id"],"report":verified["report_id"]}));
    assert_eq!(api.post("assembled-worker", &proof).await.0, 401);
    let mut fabricated = proof.clone();
    fabricated["key"] = json!("nonexistent-proof-is-inert");
    fabricated["command"]["report"] =
        json!("cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc");
    assert_eq!(
        api.post("assembled-verifier", &fabricated).await.0,
        404,
        "fabricated report identity cannot manufacture verified production"
    );
    assert_eq!(api.snapshot().await["accepted"], json!([]));
    let proven = api.post("assembled-verifier", &proof).await;
    assert_eq!(proven.0, 200, "real measured v2 proof: {}", proven.1);
    let accept = api.command(
        "accept-production",
        3,
        json!({"kind":"outcome.accept","proof":proven.1["proof"]}),
    );
    if later_failure {
        let mut failed = pass.clone();
        // The independent check remains the exact measured successful process.
        // Only the verifier's unresolved decision disposition changes.
        failed["verification"]["resolved_decisions"] = json!(false);
        let failure = api
            .artifact("assembled-verifier", "unresolved-current-gate", failed)
            .await;
        let before = service
            .snapshot(&api.fixture.owner, api.fixture.task)
            .await
            .unwrap();
        assert_eq!(before.status, "repair_required");
        let refused = api.post(&api.fixture.owner, &accept).await;
        let after = service
            .snapshot(&api.fixture.owner, api.fixture.task)
            .await
            .unwrap();
        let outcome = api.snapshot().await;
        println!(
            "public_current_gate {}",
            json!({"failure":failure,"previous_proof":proven.1,"artifact_status":after.status,"accepted":outcome["accepted"],"reports":after.reports})
        );
        assert_eq!(
            refused.0, 409,
            "an older measured PASS/proof must not bypass the current failed decision gate: {}",
            refused.1
        );
        assert_eq!(refused.1["code"], "dependency_unmet");
        assert_eq!(after.status, "repair_required");
        assert_eq!(outcome["accepted"], json!([]));
        assert_eq!(
            api.post("assembled-verifier", &proof).await.1["code"],
            "dependency_unmet",
            "cached proof cannot regain fresh authority after failure"
        );
        let old_proof_rekey = api.command("old-report-new-proof-key", 3, proof["command"].clone());
        assert_eq!(
            api.post("assembled-verifier", &old_proof_rekey).await.1["code"],
            "dependency_unmet"
        );
        let old_report_rekey = api
            .artifact_request("old-report-new-verify-key", pass.clone())
            .await;
        let rekey = api
            .artifact_response("assembled-verifier", &old_report_rekey)
            .await;
        assert_eq!(
            rekey.0, 409,
            "the old execution cannot clear failure under a new Verify key"
        );
        assert_eq!(rekey.1["code"], "dependency_unmet");
        assert_eq!(
            api.artifact_response("assembled-verifier", &initial_verify)
                .await,
            initial_verified,
            "old Verify receipt remains a read without clearing the gate"
        );
        assert_eq!(
            service
                .snapshot(&api.fixture.owner, api.fixture.task)
                .await
                .unwrap()
                .status,
            "repair_required"
        );
        supervisor
            .release("assembled-verifier", execution.id)
            .await
            .unwrap();
        let expiring = mailbox
            .record("assembled-verifier", mailbox::RecordKind::Episode, episode)
            .await
            .unwrap();
        let expiry_wait = std::time::Instant::now();
        // This fixture has no workflow registration. Let actual authority expire;
        // public admission retires the prior independently stopped/released Episode.
        tokio::time::sleep(std::time::Duration::from_secs(31)).await;
        let expiry_elapsed = expiry_wait.elapsed().as_millis();
        let fresh_input = Uuid::new_v4();
        let fresh_episode = Uuid::new_v4();
        mailbox.execute("assembled-verifier", assembled::mail(api.fixture.epoch, "capture-postfailure-verifier", json!({"kind":"capture_input","mission":api.fixture.mission,"id":fresh_input,"attempt":api.fixture.attempt,"purpose":"verification","limit":4}))).await.unwrap();
        let fresh_packet = mailbox
            .record(
                "assembled-verifier",
                mailbox::RecordKind::Input,
                fresh_input,
            )
            .await
            .unwrap();
        mailbox.execute("assembled-verifier", assembled::mail(api.fixture.epoch, "admit-postfailure-verifier", json!({"kind":"admit_episode","mission":api.fixture.mission,"id":fresh_episode,"attempt":api.fixture.attempt,"purpose":"verification","input_packet":fresh_input,"input_digest":fresh_packet["digest"]}))).await.unwrap();
        let retired = mailbox
            .record("assembled-verifier", mailbox::RecordKind::Episode, episode)
            .await
            .unwrap();
        let fresh_admission = mailbox
            .record(
                "assembled-verifier",
                mailbox::RecordKind::Episode,
                fresh_episode,
            )
            .await
            .unwrap();
        println!(
            "public_episode_expiry {}",
            json!({"before":expiring,"after":retired,"fresh":fresh_admission,"elapsed_wait_millis":expiry_elapsed,"failure_revision":failure["revision"]})
        );
        assert_eq!(retired["state"], "completed");
        assert!(
            fresh_admission["admitted_task_revision"].as_i64().unwrap()
                >= failure["revision"].as_i64().unwrap()
        );
        let fresh_binding = api.post("assembled-verifier", &api.command("bind-postfailure-verifier", 3, json!({"kind":"verification.bind","episode":fresh_episode,"intent":admitted["intent"],"acceptance":admitted["acceptance"],"policy":"suite-v2","environment":request["command"]["intent"]["acceptance"]["environment"]}))).await;
        assert_eq!(
            fresh_binding.0, 200,
            "fresh exact contract binding precedes allocation: {}",
            fresh_binding.1
        );
        let fresh_execution = supervisor
            .create_episode_from_candidate(
                "assembled-verifier",
                fresh_episode,
                &service,
                supervisor::CreateFault::None,
            )
            .await
            .unwrap();
        supervisor
            .start(
                "assembled-verifier",
                fresh_execution.id,
                command.iter().map(|s| s.to_string()).collect(),
                10,
            )
            .await
            .unwrap();
        let fresh_deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
        let fresh_measured = loop {
            if let Some(result) = supervisor
                .result("assembled-verifier", fresh_execution.id)
                .await
                .unwrap()
            {
                break result;
            }
            assert!(std::time::Instant::now() < fresh_deadline);
            tokio::time::sleep(std::time::Duration::from_millis(20)).await;
        };
        assert_ne!(fresh_measured.execution, measured.execution);
        assert_eq!(fresh_measured.exit_code, Some(0));
        assert!(fresh_measured.namespace_stopped);
        println!(
            "independent_measured_subject {}",
            json!({"phase":"postfailure","binding":fresh_binding.1,"candidate":candidate,"measured_result":fresh_measured})
        );
        let fresh_view = supervisor
            .inspect("assembled-verifier", fresh_execution.id)
            .await
            .unwrap();
        let fresh_output = std::fs::read(&fresh_view.manifest.log_path).unwrap();
        assert_eq!(fresh_output, b"independent gate\n");
        let fresh_bytes = serde_json::to_vec(&json!({"trusted_monitor_result":fresh_measured,"output":String::from_utf8(fresh_output).unwrap()})).unwrap();
        let fresh_logs = api.upload("assembled-verifier", &fresh_bytes).await;
        println!(
            "measured_gate_bytes {}",
            json!({"execution":fresh_execution.id,"logs":fresh_logs,"artifact_bytes":fresh_bytes})
        );
        let mut fresh_pass = pass;
        fresh_pass["verification"]["checks"][0]["logs"] = json!(fresh_logs);
        let fresh_verified = api
            .artifact("assembled-verifier", "fresh-postfailure-report", fresh_pass)
            .await;
        assert_ne!(fresh_verified["report_id"], verified["report_id"]);
        assert_eq!(
            service
                .snapshot(&api.fixture.owner, api.fixture.task)
                .await
                .unwrap()
                .status,
            "verifying"
        );
        let fresh_proof_request = api.command("fresh-postfailure-proof", 4, json!({"kind":"production.verify","binding":fresh_binding.1["binding"],"candidate":submitted["candidate_id"],"report":fresh_verified["report_id"]}));
        let fresh_proof = api.post("assembled-verifier", &fresh_proof_request).await;
        assert_eq!(
            fresh_proof.0, 200,
            "eligible postfailure evidence produces a new proof: {}",
            fresh_proof.1
        );
        let obsolete = api.command(
            "old-proof-after-fresh-gate",
            5,
            json!({"kind":"outcome.accept","proof":proven.1["proof"]}),
        );
        assert_eq!(
            api.post(&api.fixture.owner, &obsolete).await.1["code"],
            "dependency_unmet",
            "clearing the gate cannot reinterpret old completed verification"
        );
        let old_after_fresh =
            api.command("old-report-after-fresh-gate", 5, proof["command"].clone());
        assert_eq!(
            api.post("assembled-verifier", &old_after_fresh).await.1["code"],
            "dependency_unmet"
        );
        assert_eq!(api.snapshot().await["accepted"], json!([]));
        let fresh_accept = api.command(
            "accept-fresh-postfailure-proof",
            5,
            json!({"kind":"outcome.accept","proof":fresh_proof.1["proof"]}),
        );
        let fresh_accepted = api.post(&api.fixture.owner, &fresh_accept).await;
        assert_eq!(
            fresh_accepted.0, 200,
            "fresh measured and bound proof accepts: {}",
            fresh_accepted.1
        );
        assert_eq!(
            api.post(&api.fixture.owner, &fresh_accept).await,
            fresh_accepted
        );
        assert_eq!(
            api.post("assembled-verifier", &fresh_proof_request).await.1["code"],
            "dependency_unmet",
            "cached Verifier commands cannot mutate accepted work; exact Owner acceptance remains inspectable"
        );
        assert_eq!(
            api.post("assembled-verifier", &proof).await.1["code"],
            "dependency_unmet",
            "an unaccepted older proof does not inherit the new acceptance"
        );
        let final_read = service
            .snapshot(&api.fixture.owner, api.fixture.task)
            .await
            .unwrap();
        assert_eq!(final_read.status, "accepted");
        for report in &after.reports {
            assert!(
                final_read
                    .reports
                    .iter()
                    .any(|r| serde_json::to_value(r).unwrap()
                        == serde_json::to_value(report).unwrap()),
                "immutable older measured reports remain inspectable"
            );
        }
        let final_outcomes = api.snapshot().await;
        assert_eq!(final_outcomes["accepted"].as_array().unwrap().len(), 1);
        assert_eq!(
            final_outcomes["accepted"][0]["proof_id"],
            fresh_proof.1["proof"]
        );
        println!(
            "public_current_gate {}",
            json!({"phase":"postfailure_accepted","artifact_status":final_read.status,"accepted":final_outcomes["accepted"],"reports":final_read.reports})
        );
        supervisor
            .release("assembled-verifier", fresh_execution.id)
            .await
            .unwrap();
        let owned_root = api.fixture.root.clone();
        api.finish().await;
        println!(
            "measured_fixture_cleanup {}",
            json!({"root":owned_root,"fixture_finish":!owned_root.exists(),"root_exists":owned_root.exists(),"namespace_stopped":measured.namespace_stopped && fresh_measured.namespace_stopped,"released_executions":[execution.id,fresh_execution.id]})
        );
        return;
    }
    let accepted = api.post(&api.fixture.owner, &accept).await;
    assert_eq!(accepted.0, 200);
    assert_eq!(accepted.1["outcome"], "production");
    assert_eq!(
        api.post(&api.fixture.owner, &accept).await,
        accepted,
        "successful exact acceptance receipt remains idempotent"
    );
    let read = service
        .snapshot(&api.fixture.owner, api.fixture.task)
        .await
        .unwrap();
    assert_eq!(serde_json::to_value(read.candidate).unwrap(), candidate);
    assert_eq!(read.status, "accepted");
    if amendment.is_some() {
        if unresolved_operation.is_none() {
            supervisor
                .release("assembled-verifier", execution.id)
                .await
                .unwrap();
        }
        let completed =
            amended_production_case(&api, &request, &command, episode, unresolved_operation).await;
        let owned_root = api.fixture.root.clone();
        api.finish().await;
        println!(
            "measured_fixture_cleanup {}",
            json!({"root":owned_root,"root_exists":owned_root.exists(),"fixture_finish":!owned_root.exists(),"namespace_stopped":measured.namespace_stopped,"released_executions":[execution.id]})
        );
        assert_eq!(
            completed.0,
            if unresolved_operation.is_some() {
                409
            } else {
                200
            },
            "expired, measured-stopped and released original verifier must retire across its exact admitted amendment: {}",
            completed.1
        );
        return;
    }
    let late=api.command("old-v1-pass-cannot-rebind",4,json!({"kind":"verification.bind","episode":episode,"intent":admitted["intent"],"acceptance":admitted["acceptance"],"policy":"suite-v2","environment":request["command"]["intent"]["acceptance"]["environment"]}));
    assert_eq!(
        api.post("assembled-verifier", &late).await.1["code"],
        "dependency_unmet"
    );
    supervisor
        .release("assembled-verifier", execution.id)
        .await
        .unwrap();
    api.finish().await;
}

async fn original_attempt_unknown_effect(api: &Api) -> Uuid {
    use team_control_plane::gateway::*;
    let gateway = Gateway::new(api.fixture.broker.clone());
    let identity = RuntimeIdentity {
        runtime_kind: "fault".into(),
        runtime_version: "v1".into(),
        deployment: "fixture".into(),
        thread_store: format!("original-attempt-{}", api.fixture.attempt),
        endpoint: "local".into(),
        environment: "disposable".into(),
    };
    let directory = api.fixture.root.join("controlled-synthetic-effect");
    std::fs::create_dir(&directory).unwrap();
