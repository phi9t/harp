//! Public JSON contract tests: removing admission or its immutable persistence
//! must fail observable HTTP results and durable reads on real PostgreSQL.
#[allow(dead_code)]
#[path = "support/assembled.rs"]
mod assembled;
#[allow(dead_code)]
#[path = "support/gateway_fault.rs"]
mod gateway_fault;
use assembled::Fixture;
use serde_json::{Value, json};
use team_control_plane::{artifacts, http};
use uuid::Uuid;

struct Api {
    fixture: Fixture,
    client: reqwest::Client,
    url: String,
    server: tokio::task::JoinHandle<()>,
}
impl Api {
    fn command(&self, key: &str, revision: i64, command: Value) -> Value {
        json!({"schema_version":2,"key":key,"expected_revision":revision,"recovery_epoch":self.fixture.epoch,"task":self.fixture.task,"command":command})
    }
    async fn new() -> Self {
        let fixture = Fixture::without_requirement().await;
        println!(
            "postgres_fixture {}",
            json!({"dsn":std::env::var("TEAM_CONTROL_PLANE_TEST_DSN").unwrap(),"epoch":fixture.epoch})
        );
        Self::from_fixture(fixture).await
    }
    async fn measured() -> Self {
        Self::from_fixture(Fixture::new().await).await
    }
    async fn from_fixture(fixture: Fixture) -> Self {
        let service = artifacts::ArtifactService::open(
            fixture.broker.clone(),
            &fixture.root.join("artifacts"),
        )
        .await
        .unwrap();
        let router = http::router_with_artifacts(fixture.broker.clone(), service);
        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
        let url = format!("http://{}", listener.local_addr().unwrap());
        let server = tokio::spawn(async move { axum::serve(listener, router).await.unwrap() });
        Self {
            fixture,
            client: reqwest::Client::new(),
            url,
            server,
        }
    }
    fn admission(&self, key: &str, revision: i64) -> Value {
        let snapshot = b"produce exact src/result";
        json!({"schema_version":2,"key":key,"expected_revision":revision,
            "recovery_epoch":self.fixture.epoch,"task":self.fixture.task,
            "command":{"kind":"intent.admit",
                "work":{"ledger":"git","deployment":"fixture-deployment","tenant":"fixture-tenant","project":"fixture-project","item":"26"},
                "source":{"adapter":"git","locator":self.fixture.root.join("store/SPEC.md"),"revision":self.fixture.base,"availability":"available","snapshot":snapshot,"digest":"881fa3537a1d388a9b61011411583564a434fdc7ad8b821de142d378e7bbead3"},
                "intent":{"objective":"produce exact result","constraints":["owned fixture only"],"allowed_effects":["read","write"],
                    "resources":{"attempts":8,"episodes":8,"repairs":3,"execution_seconds":30},
                    "acceptance":{"outcome":"production","allow_negative":false,"criteria":["independent exact verification"],"verifier":self.fixture.verifier,"policy":"suite-v2","suite":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","environment":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","mandatory_commands":[["true"]]},
                    "dependencies":[],"legacy_spec_digest":self.fixture.spec}}})
    }
    async fn post(&self, token: &str, body: &Value) -> (u16, Value) {
        let response = self
            .client
            .post(format!("{}/v2/contracts/commands", self.url))
            .bearer_auth(token)
            .json(body)
            .send()
            .await
            .unwrap();
        let status = response.status().as_u16();
        let bytes = response.bytes().await.unwrap();
        let value = serde_json::from_slice(&bytes)
            .unwrap_or_else(|_| json!({"unparsed":String::from_utf8_lossy(&bytes)}));
        println!(
            "public_contract_response {}",
            json!({"key":body["key"],"family":body["command"]["kind"],"task":body["task"],"status":status,"result":value})
        );
        (status, value)
    }
    async fn snapshot(&self) -> Value {
        let response = self
            .client
            .get(format!(
                "{}/v2/contracts/tasks/{}",
                self.url, self.fixture.task
            ))
            .bearer_auth(&self.fixture.owner)
            .send()
            .await
            .unwrap();
        assert_eq!(response.status().as_u16(), 200);
        response.json().await.unwrap()
    }
    async fn finish(self) {
        self.server.abort();
        // Retain uncertain fixtures, including usage unknown after a physical
        // effect. Fixture.finish is filesystem/schema disposal, never Stop proof.
        let (db, connection)=tokio_postgres::connect(&self.fixture.dsn,tokio_postgres::NoTls).await.unwrap();
        tokio::spawn(async move {connection.await.unwrap()});
        let unknown:bool=db.query_one("SELECT EXISTS(SELECT 1 FROM gateway_operations WHERE state IN ('dispatching','outcome_unknown','quarantined') OR (state IN ('confirmed','failed_known') AND COALESCE(usage->>'kind','unknown')<>'measured_zero')) OR EXISTS(SELECT 1 FROM episode_runtime_operations WHERE state IN ('dispatching','outcome_unknown','quarantined') OR (state IN ('confirmed','failed_known') AND COALESCE(usage->>'kind','unknown')<>'measured_zero'))", &[]).await.unwrap().get(0);
        if unknown {
            println!("fixture_retained_unknown {}",json!({"root":self.fixture.root,"dsn":self.fixture.dsn,"fixture_finish":false,"reason":"unresolved runtime usage/effect retained"}));
        } else {
            let root=self.fixture.root.clone();let dsn=self.fixture.dsn.clone();
            self.fixture.finish().await;
            println!("fixture_disposal {}",json!({"root":root,"dsn":dsn,"root_exists":root.exists(),"fixture_finish":true,"independent_shutdown_claim":false}));
        }
    }
    async fn legacy_task(&self, task: Uuid) -> Value {
        let response = self
            .client
            .get(format!("{}/v1/snapshots/task/{task}", self.url))
            .bearer_auth(&self.fixture.owner)
            .send()
            .await
            .unwrap();
        assert_eq!(response.status().as_u16(), 200);
        response.json().await.unwrap()
    }
    async fn v1(
        &self,
        key: &str,
        revision: i64,
        generation: Option<i64>,
        command: Value,
    ) -> (u16, Value) {
        let body = json!({"schema_version":1,"key":key,"expected_revision":revision,"expected_generation":generation,"recovery_epoch":self.fixture.epoch,"command":command});
        let response = self
            .client
            .post(format!("{}/v1/commands", self.url))
            .bearer_auth(&self.fixture.owner)
            .json(&body)
            .send()
            .await
            .unwrap();
        let status = response.status().as_u16();
        let value: Value = response.json().await.unwrap();
        println!(
            "public_v1_response {}",
            json!({"body":body,"status":status,"result":value})
        );
        (status, value)
    }
    async fn mail(&self, token: &str, key: &str, command: Value) -> (u16, Value) {
        let body = json!({"schema_version":1,"key":key,"recovery_epoch":self.fixture.epoch,"command":command});
        let response = self
            .client
            .post(format!("{}/v1/mailbox/commands", self.url))
            .bearer_auth(token)
            .json(&body)
            .send()
            .await
            .unwrap();
        let status = response.status().as_u16();
        let value: Value = response.json().await.unwrap();
        println!(
            "public_mailbox_response {}",
            json!({"body":body,"status":status,"result":value})
        );
        (status, value)
    }
    async fn contract_read(&self, task: Uuid) -> Value {
        self.client
            .get(format!("{}/v2/contracts/tasks/{task}", self.url))
            .bearer_auth(&self.fixture.owner)
            .send()
            .await
            .unwrap()
            .json()
            .await
            .unwrap()
    }
    async fn mission(&self) -> Value {
        self.client
            .get(format!(
                "{}/v1/mailbox/missions/{}",
                self.url, self.fixture.mission
            ))
            .bearer_auth(&self.fixture.owner)
            .send()
            .await
            .unwrap()
            .json()
            .await
            .unwrap()
    }
    async fn mission_accounting(&self) -> Value {
        let response = self
            .client
            .get(format!(
                "{}/v1/snapshots/mission/{}",
                self.url, self.fixture.mission
            ))
            .bearer_auth(&self.fixture.owner)
            .send()
            .await
            .unwrap();
        assert_eq!(response.status().as_u16(), 200);
        response.json::<Value>().await.unwrap()["data"].clone()
    }
    async fn cancel_attempt(&self, task: Uuid, attempt: Uuid) {
        let before = self.legacy_task(task).await;
        let command = json!({"schema_version":1,"key":"cancel-contract-result","expected_revision":before["revision"],"expected_generation":null,"recovery_epoch":self.fixture.epoch,"command":{"kind":"cancel_attempt","task_id":task,"attempt_id":attempt,"reason":"Owner fences future contract results"}});
        let response = self
            .client
            .post(format!("{}/v1/commands", self.url))
            .bearer_auth(&self.fixture.owner)
            .json(&command)
            .send()
            .await
            .unwrap();
        let status = response.status().as_u16();
        let result: Value = response.json().await.unwrap();
        println!(
            "public_cancellation {}",
            json!({"task":task,"attempt":attempt,"status":status,"result":result})
        );
        assert_eq!(status, 200, "real cancellation: {result}");
        assert_eq!(result["disposition"], "cancellation_requested");
    }
}

#[tokio::test]
async fn cancellation_fences_fresh_research_proof_and_preserves_read_authority() {
    cancelled_outcome_case(CancelledOutcome::Proof).await;
}

#[tokio::test]
async fn cancellation_fences_fresh_outcome_acceptance_and_preserves_read_authority() {
    cancelled_outcome_case(CancelledOutcome::Acceptance).await;
}

#[tokio::test]
async fn completed_research_refuses_cancellation_and_preserves_exact_acceptance_receipt() {
    cancelled_outcome_case(CancelledOutcome::Replay).await;
}

enum CancelledOutcome {
    Proof,
    Acceptance,
    Replay,
}

async fn cancelled_outcome_case(scenario: CancelledOutcome) {
    let api = Api::new().await;
    let intent = api
        .research_intent("cancelled-research", 0, "cancelled-r1")
        .await;
    let bytes = b"immutable independent investigation evidence under original contract";
    let evidence = api.upload("assembled-worker", bytes).await;
    let proposed=api.post("assembled-worker",&api.command("before-cancel-proposal",1,json!({"kind":"outcome.propose","intent":intent["intent"],"evidence":evidence,"negative":true,"evaluator_change":false}))).await;
    assert_eq!(proposed.0, 200);
    let verify=api.command("before-cancel-verify",1,json!({"kind":"research.verify","intent":intent["intent"],"acceptance":intent["acceptance"],"proposal":proposed.1["proposal"],"policy":"suite-v2","environment":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}));
    let (token, mutation) = if matches!(scenario, CancelledOutcome::Proof) {
        ("assembled-verifier".to_owned(), verify)
    } else {
        let proof = api.post("assembled-verifier", &verify).await;
        assert_eq!(
            proof.0, 200,
            "current verification before cancellation positive"
        );
        let accept = api.command(
            "before-cancel-accept",
            2,
            json!({"kind":"outcome.accept","proof":proof.1["proof"]}),
        );
        if matches!(scenario, CancelledOutcome::Replay) {
            assert_eq!(
                api.post(&api.fixture.owner, &accept).await.0,
                200,
                "current acceptance before cancellation positive"
            );
        }
        (api.fixture.owner.clone(), accept)
    };
    let before = api.snapshot().await;
    let legacy_before = api.legacy_task(api.fixture.task).await;
    let evidence_read_before = api
        .client
        .get(format!(
            "{}/v1/artifacts/tasks/{}/objects/{evidence}",
            api.url, api.fixture.task
        ))
        .bearer_auth("assembled-worker")
        .send()
        .await
        .unwrap()
        .status()
        .as_u16();
    assert_eq!(
        evidence_read_before, 401,
        "unpromoted proposal grants no legacy artifact read scope"
    );
    let capacity_before: Value = api
        .client
        .get(format!("{}/v1/kernel/status", api.url))
        .bearer_auth(&api.fixture.owner)
        .send()
        .await
        .unwrap()
        .json()
        .await
        .unwrap();
    if matches!(scenario, CancelledOutcome::Replay) {
        let refused=api.v1("cannot-cancel-accepted",legacy_before["revision"].as_i64().unwrap(),None,json!({"kind":"cancel_attempt","task_id":api.fixture.task,"attempt_id":api.fixture.attempt,"reason":"completed work cannot be cancelled"})).await;
        assert_eq!(refused.1["code"],"dependency_unmet");
        assert_eq!(api.post(&token,&mutation).await.0,200,"authenticated exact acceptance inspection survives refused cancellation");
        assert_eq!(api.snapshot().await["accepted"],before["accepted"]);
        api.finish().await;
        return;
    }
    api.cancel_attempt(api.fixture.task, api.fixture.attempt)
        .await;
    let result = api.post(&token, &mutation).await;
    let after = api.snapshot().await;
    let legacy_after = api.legacy_task(api.fixture.task).await;
    let capacity_after: Value = api
        .client
        .get(format!("{}/v1/kernel/status", api.url))
        .bearer_auth(&api.fixture.owner)
        .send()
        .await
        .unwrap()
        .json()
        .await
        .unwrap();
    let read = api
        .client
        .get(format!(
            "{}/v1/artifacts/tasks/{}/objects/{evidence}",
            api.url, api.fixture.task
        ))
        .bearer_auth("assembled-worker")
        .send()
        .await
        .unwrap();
    let read_status = read.status().as_u16();
    let service = artifacts::ArtifactService::open(
        api.fixture.broker.clone(),
        &api.fixture.root.join("artifacts"),
    )
    .await
    .unwrap();
    let collected = service
        .collect(&api.fixture.owner, std::time::Duration::ZERO)
        .await
        .unwrap();
    assert!(
        !collected.contains(&evidence),
        "cancellation preserves immutable referenced investigation evidence"
    );
    let retained_bytes = service.store().read(&evidence).unwrap();
    println!(
        "public_cancelled_outcome_read {}",
        json!({"before":before,"after":after,"legacy_after":legacy_after,"capacity_before":capacity_before,"capacity_after":capacity_after,"evidence":evidence,"read_status":read_status})
    );
    api.finish().await;
    assert_eq!(
        result.0, 409,
        "cancellation must fence v2 result/acceptance mutation including exact cached replay: {}",
        result.1
    );
    assert_eq!(result.1["code"], "dependency_unmet");
    assert_eq!(after["revision"], before["revision"]);
    assert_eq!(after["accepted"], before["accepted"]);
    assert_eq!(after["sources"], before["sources"]);
    assert_eq!(
        legacy_after["data"]["operations"],
        legacy_before["data"]["operations"]
    );
    assert_eq!(
        capacity_after["missions"][0]["used_capacity"],
        capacity_before["missions"][0]["used_capacity"]
    );
    assert_eq!(
        capacity_after["missions"][0]["admitted_attempts"],
        capacity_before["missions"][0]["admitted_attempts"]
    );
    assert_eq!(read_status, evidence_read_before);
    assert_eq!(retained_bytes.as_slice(), bytes);
}

#[tokio::test]
async fn additive_upgrade_preserves_exact_legacy_specs_and_nullable_original_provenance() {
    use team_control_plane::*;
    let api = Api::new().await;
    let lead_episode = api.fixture.lead_episode("legacy-null-attempt").await;
    let supervisor = api.fixture.supervisor().await;
    let execution = supervisor
        .create_episode(
            "assembled-lead",
            lead_episode,
            vec![],
            supervisor::CreateFault::None,
        )
        .await
        .unwrap();
    let (db, connection) = tokio_postgres::connect(&api.fixture.dsn, tokio_postgres::NoTls)
        .await
        .unwrap();
    tokio::spawn(async move { connection.await.unwrap() });
    let original:Value=db.query_one("SELECT jsonb_build_object('specs',(SELECT jsonb_agg(to_jsonb(s) ORDER BY digest) FROM task_specs s),'attempts',(SELECT jsonb_agg(to_jsonb(a) ORDER BY id) FROM attempts a),'reservations',(SELECT jsonb_agg(to_jsonb(z) ORDER BY id) FROM reservations z),'workspace',(SELECT to_jsonb(w) FROM supervised_workspaces w WHERE w.id=$1),'episode',(SELECT to_jsonb(e) FROM mailbox_episodes e WHERE e.id=$2),'execution',(SELECT to_jsonb(x) FROM episode_executions x WHERE x.execution_id=$1))",&[&execution.id,&lead_episode]).await.unwrap().get(0);
    assert!(original["workspace"]["attempt_id"].is_null());
    assert!(original["execution"]["attempt_id"].is_null());
    assert!(original["episode"]["attempt_id"].is_null());
    // Reconstruct an owned legacy deployment: only the empty v2 tables are
    // removed. All actual original v1 provenance is retained unchanged.
    db.batch_execute("ALTER TABLE attempts DROP CONSTRAINT attempts_task_generation_key; ALTER TABLE attempts ADD CONSTRAINT attempts_task_id_key UNIQUE(task_id); DROP TABLE contract_attempt_schema_version,contract_schema_version,contract_legacy_bindings,contract_current,contract_work,contract_sources,contract_acceptance,contract_intents,contract_commands,contract_proposals,contract_delegations,contract_plans,contract_completed_steps,contract_verification_bindings,contract_proofs,contract_outcomes,contract_dependencies,contract_dependency_revalidations CASCADE").await.unwrap();
    migrate(&api.fixture.dsn).await.unwrap();
    migrate(&api.fixture.dsn).await.unwrap();
    let retained:Value=db.query_one("SELECT jsonb_build_object('specs',(SELECT jsonb_agg(to_jsonb(s) ORDER BY digest) FROM task_specs s),'attempts',(SELECT jsonb_agg(to_jsonb(a) ORDER BY id) FROM attempts a),'reservations',(SELECT jsonb_agg(to_jsonb(z) ORDER BY id) FROM reservations z),'workspace',(SELECT to_jsonb(w) FROM supervised_workspaces w WHERE w.id=$1),'episode',(SELECT to_jsonb(e) FROM mailbox_episodes e WHERE e.id=$2),'execution',(SELECT to_jsonb(x) FROM episode_executions x WHERE x.execution_id=$1))",&[&execution.id,&lead_episode]).await.unwrap().get(0);
    assert_eq!(
        retained, original,
        "migration must preserve every exact legacy binding and absent original Attempt"
    );
    let mapping:Value=db.query_one("SELECT jsonb_build_object('original_spec',original_spec,'disposition',disposition) FROM contract_legacy_bindings WHERE task_id=$1 AND spec_digest=$2",&[&api.fixture.task,&api.fixture.spec]).await.unwrap().get(0);
    assert_eq!(mapping["original_spec"], original["specs"][0]);
    assert_eq!(mapping["disposition"], "explicit_mapping_required");
    let closed = api.snapshot().await;
    assert_eq!(closed["admission_open"], false);
    assert_eq!(closed["intents"], json!([]));
    let mut ambiguous = api.admission("wrong-legacy-binding", 0);
    ambiguous["command"]["intent"]["legacy_spec_digest"] =
        json!("cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc");
    assert_eq!(
        api.post(&api.fixture.owner, &ambiguous).await.1["code"],
        "stale_revision"
    );
    assert_eq!(api.snapshot().await["admission_open"], false);
    let admitted = api
        .post(&api.fixture.owner, &api.admission("explicit-mapping", 0))
        .await;
    assert_eq!(admitted.0, 200);
    assert!(
        db.execute("UPDATE contract_intents SET intent='{}'::jsonb", &[])
            .await
            .is_err()
    );
    assert!(
        db.execute("DELETE FROM contract_sources", &[])
            .await
            .is_err()
    );
    supervisor
        .cancel("assembled-lead", execution.id)
        .await
        .unwrap();
    supervisor
        .reconcile("assembled-lead", execution.id)
        .await
        .unwrap();
    supervisor
        .release("assembled-lead", execution.id)
        .await
        .unwrap();
    println!("migration_original_provenance {}", original);
    api.finish().await;
}

#[tokio::test]
async fn partial_attempt_identity_migration_closes_public_contract_admission() {
    use team_control_plane::*;
    let api = Api::new().await;
    let (db, connection) = tokio_postgres::connect(&api.fixture.dsn, tokio_postgres::NoTls)
        .await
        .unwrap();
    tokio::spawn(async move { connection.await.unwrap() });
    db.batch_execute("ALTER TABLE attempts DROP CONSTRAINT attempts_task_generation_key; ALTER TABLE attempts ADD CONSTRAINT attempts_task_id_key UNIQUE(task_id)").await.unwrap();
    assert_eq!(
        migrate(&api.fixture.dsn).await.unwrap_err().code,
        ErrorCode::IncompatibleSchema
    );
    let refused = api
        .post(
            &api.fixture.owner,
            &api.admission("partial-schema-refused", 0),
        )
        .await;
    assert_eq!(refused.0, 409);
    assert_eq!(refused.1["code"], "incompatible_schema");
    db.batch_execute("ALTER TABLE attempts DROP CONSTRAINT attempts_task_id_key; ALTER TABLE attempts ADD CONSTRAINT attempts_task_generation_key UNIQUE(task_id,generation)").await.unwrap();
    migrate(&api.fixture.dsn).await.unwrap();
    migrate(&api.fixture.dsn).await.unwrap();
    assert_eq!(api.snapshot().await["intents"], json!([]));
    api.finish().await;
}

impl Api {
    async fn upload(&self, token: &str, bytes: &[u8]) -> String {
        let digest = artifacts::sha256(bytes);
        let response = self
            .client
            .post(format!("{}/v1/artifacts/objects", self.url))
            .bearer_auth(token)
            .json(&json!({"task":self.fixture.task,"digest":digest,"bytes":bytes}))
            .send()
            .await
            .unwrap();
        assert_eq!(
            response.status().as_u16(),
            200,
            "real immutable evidence publication"
        );
        digest
    }
    async fn artifact(&self, token: &str, key: &str, command: Value) -> Value {
        let request = self.artifact_request(key, command).await;
        let (status, value) = self.artifact_response(token, &request).await;
        assert_eq!(status, 200, "ArtifactService {key}: {value}");
        value
    }
    async fn artifact_request(&self, key: &str, command: Value) -> Value {
        let snapshot: Value = self
            .client
            .get(format!(
                "{}/v1/artifacts/tasks/{}",
                self.url, self.fixture.task
            ))
            .bearer_auth(&self.fixture.owner)
            .send()
            .await
            .unwrap()
            .json()
            .await
            .unwrap();
        let task = self.legacy_task(self.fixture.task).await;
        json!({"key":key,"task":self.fixture.task,"expected_revision":snapshot["revision"],"generation":task["data"]["generation"],"recovery_epoch":self.fixture.epoch,"command":command})
    }
    async fn artifact_response(&self, token: &str, request: &Value) -> (u16, Value) {
        let response = self
            .client
            .post(format!("{}/v1/artifacts/commands", self.url))
            .bearer_auth(token)
            .json(request)
            .send()
            .await
            .unwrap();
        let status = response.status().as_u16();
        let value: Value = response.json().await.unwrap();
        println!(
            "public_artifact_response {}",
            json!({"key":request["key"],"family":request["command"]["kind"],"task":request["task"],"status":status,"result":value})
        );
        (status, value)
    }
    async fn research_intent(&self, key: &str, revision: i64, source_revision: &str) -> Value {
        let mut request = self.admission(key, revision);
        request["command"]["source"]["revision"] = json!(source_revision);
        request["command"]["intent"]["acceptance"]["outcome"] = json!("investigation_complete");
        request["command"]["intent"]["acceptance"]["allow_negative"] = json!(true);
        let result = self.post(&self.fixture.owner, &request).await;
        assert_eq!(result.0, 200, "research admission: {}", result.1);
        result.1
    }
    async fn accept_research(&self, intent: &Value, start: i64, key: &str) -> Value {
        self.accept_research_as(intent,start,key,"assembled-worker","assembled-verifier").await
    }
    async fn accept_research_as(&self, intent: &Value, start: i64, key: &str, worker: &str, verifier: &str) -> Value {
        let evidence = self
            .upload(
                worker,
                b"retained investigation: no feasible candidate under admitted constraints",
            )
            .await;
        let proposal=self.command(&format!("{key}-proposal"),start,json!({"kind":"outcome.propose","intent":intent["intent"],"evidence":evidence,"negative":true,"evaluator_change":false}));
        let proposed = self.post(worker, &proposal).await;
        assert_eq!(proposed.0, 200, "worker proposal: {}", proposed.1);
        assert_eq!(proposed.1["disposition"], "proposed");
        let verification=self.command(&format!("{key}-verify"),start,json!({"kind":"research.verify","intent":intent["intent"],"acceptance":intent["acceptance"],"proposal":proposed.1["proposal"],"policy":"suite-v2","environment":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}));
        assert_eq!(
            self.post(worker, &verification).await.0,
            401,
            "worker cannot manufacture verified outcome"
        );
        let verified = self.post(verifier, &verification).await;
        assert_eq!(
            verified.0, 200,
            "independent research verification: {}",
            verified.1
        );
        let accept = self.command(
            &format!("{key}-accept"),
            start + 1,
            json!({"kind":"outcome.accept","proof":verified.1["proof"]}),
        );
        assert_eq!(self.post(worker, &accept).await.0, 401);
        let accepted = self.post(&self.fixture.owner, &accept).await;
        assert_eq!(accepted.0, 200, "owner research acceptance: {}", accepted.1);
        assert_eq!(accepted.1["outcome"], "investigation_complete");
        accepted.1
    }
}

