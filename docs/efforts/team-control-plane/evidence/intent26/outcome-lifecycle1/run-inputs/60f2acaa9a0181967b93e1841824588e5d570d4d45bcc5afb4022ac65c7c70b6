        .unwrap();
    assert_eq!(response.status().as_u16(), 409);
    assert_eq!(
        response.json::<Value>().await.unwrap()["code"],
        "dependency_unmet"
    );
    let retained = api
        .fixture
        .broker
        .snapshot(&api.fixture.owner, SnapshotQuery::Task(api.fixture.task))
        .await
        .unwrap();
    assert_eq!(retained.data["operations"], prior.data["operations"]);
    if matches!(scenario, PrerequisiteCase::DelegatedAmendment) {
        let replacement = json!({"schema_version":1,"key":"activate-dependent-lead","recovery_epoch":api.fixture.epoch,"command":{"kind":"replace_lead","mission":api.fixture.mission,"expected_generation":0,"credential_id":Uuid::new_v4(),"principal":api.fixture.lead,"token_hash":token_hash("dependent-lead"),"expires_in_seconds":300}});
        let response = api
