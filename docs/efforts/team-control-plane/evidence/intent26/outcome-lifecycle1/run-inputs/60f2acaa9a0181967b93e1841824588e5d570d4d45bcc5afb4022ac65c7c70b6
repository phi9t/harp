            println!(
                "public_owner_plan_ceiling {}",
                json!({"dimension":dimension,"result":owner,"owner_intent":owner_intent,"plans":api.snapshot().await["plans"]})
            );
            let refused = owner.0 == if code == "unauthorized" { 401 } else { 409 };
            if refused {
                let mut owner_unchanged = narrower.clone();
                owner_unchanged["intent"] = owner_intent.1["intent"].clone();
                assert_eq!(
                    api.post(
                        &api.fixture.owner,
                        &api.command(
                            "owner-unchanged-plan-after-source",
                            7,
                            json!({"kind":"plan.admit","plan":owner_unchanged})
                        )
                    )
                    .await
                    .0,
                    200
                );
                let mut owner_narrower = owner_unchanged;
                owner_narrower["resources"] =
                    json!({"attempts":1,"episodes":1,"repairs":0,"execution_seconds":8});
                assert_eq!(
                    api.post(
                        &api.fixture.owner,
                        &api.command(
                            "owner-narrower-plan-after-source",
                            8,
                            json!({"kind":"plan.admit","plan":owner_narrower})
                        )
                    )
                    .await
                    .0,
                    200
                );
            }
            observations.push((format!("owner-{dimension}"), owner.clone(), code.to_owned()));
            let budget_after_owner = api.mission_accounting().await;
            assert_eq!(
                budget_after_owner, budget_before_owner,
                "source/strategy edits cannot change cumulative mission budgets, counters or epochs"
            );
            println!(
                "public_strategy_accounting {}",
                json!({"dimension":dimension,"before":budget_before_owner,"after":budget_after_owner,"owner_plan_result":owner})
            );
            assert_eq!(
                api.snapshot().await["plans"][0]["plan"],
                plan,
                "original Plan remains immutable"
            );
        }
        observations.push((dimension.to_owned(), expanded, code.to_owned()));
        api.finish().await;
    }
    for (dimension, result, code) in observations {
        assert_eq!(
            result.0,
            if code == "unauthorized" { 401 } else { 409 },
            "source-only admission cannot grant {dimension} expansion: {}",
            result.1
        );
        assert_eq!(result.1["code"], code);
    }
}

