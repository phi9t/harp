        assert_eq!(response.status().as_u16(), 200);
        let mut delegation = api.command("dependent-delegation",2,json!({"kind":"delegation.admit","delegation":{"id":Uuid::new_v4(),"principal":api.fixture.lead,"role_epoch":1,"work":request["command"]["work"],"families":["intent.admit"],"effects":["read","write"],"max_intents":4,"max_plans":4,"resources":{"attempts":8,"episodes":8,"repairs":3,"execution_seconds":30},"expires_in_seconds":300}}));
        delegation["task"] = json!(dependent);
        assert_eq!(api.post(&api.fixture.owner, &delegation).await.0, 200);
        let mut drop = request.clone();
        drop["key"] = json!("lead-removes-prerequisites");
        drop["expected_revision"] = json!(3);
        drop["command"]["source"]["revision"] = json!("delegated-source-amendment");
        drop["command"]["intent"]["dependencies"] = json!([]);
        let attempted = api.post("dependent-lead", &drop).await;
        let after: Value = api
            .client
