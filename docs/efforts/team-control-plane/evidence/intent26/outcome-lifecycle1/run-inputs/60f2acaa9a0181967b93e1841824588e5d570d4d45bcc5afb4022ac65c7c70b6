    let response = api
        .client
        .post(format!("{}/v1/mailbox/commands", api.url))
        .bearer_auth("dependent-worker")
        .json(&episode_request)
        .send()
        .await
        .unwrap();
    assert_eq!(
        response.status().as_u16(),
        409,
        "suspended dependency must block fresh Worker Episode"
    );
    assert_eq!(
        response.json::<Value>().await.unwrap()["code"],
        "dependency_unmet"
    );
    let old_revalidation = api.post(&api.fixture.owner, &revalidate).await;
    assert_eq!(
        old_revalidation.1["code"], "dependency_unmet",
        "cached revalidation cannot acquire current authority for superseded prerequisite"
    );
    if matches!(scenario, PrerequisiteCase::ExistingStart) {
        api.cancel_attempt(
            dependent,
            Uuid::parse_str(attempt.as_str().unwrap()).unwrap(),
        )
        .await;
        assert_eq!(
            gateway
                .inspect("dependent-worker", prepared_starts[0].id)
                .await
                .unwrap()
                .operation
                .state,
            gateway::OperationState::Prepared
        );
        assert_eq!(
            gateway
                .reconcile(&api.fixture.owner, prepared_starts[0].id)
                .await
                .unwrap()
                .state,
            gateway::OperationState::Prepared,
            "cancellation preserves previous effect reconciliation"
        );
    }
    for start in prepared_starts {
        supervisor
            .cancel("dependent-worker", start.execution)
            .await
            .unwrap();
        supervisor
            .reconcile("dependent-worker", start.execution)
            .await
            .unwrap();
        supervisor
            .release("dependent-worker", start.execution)
            .await
            .unwrap();
    }
    api.finish().await;
}

