            .unwrap();
        assert_eq!(
            serde_json::to_value(&cached_start).unwrap(),
            serde_json::to_value(&earlier_start).unwrap(),
            "previous Start receipt remains attributable after suspension"
        );
        assert_eq!(
            gateway
                .inspect("dependent-worker", earlier_start.id)
                .await
                .unwrap()
                .prepared
                .start
                .execution,
            prepared_starts[0].execution
        );
        assert_eq!(
            gateway
                .reconcile(&api.fixture.owner, earlier_start.id)
                .await
                .unwrap()
                .state,
            gateway::OperationState::Prepared
