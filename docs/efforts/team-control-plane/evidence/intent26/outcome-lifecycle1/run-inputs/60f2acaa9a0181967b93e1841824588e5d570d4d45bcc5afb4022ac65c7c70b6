            .unwrap();
        let status = response.status().as_u16();
        let result: Value = response.json().await.unwrap();
        println!(
            "public_dependency_grant {}",
            json!({"task":dependent,"status":status,"result":result})
        );
        if attempted.0 != 401 {
            api.finish().await;
            assert_eq!(
                attempted.0, 401,
                "general intent delegation cannot remove prerequisites and reopen grants: {}",
                attempted.1
            );
            return;
        }
        assert_eq!(after["dependencies"][0]["disposition"], "suspended");
        assert_eq!(status, 409);
        assert_eq!(result["code"], "dependency_unmet");
        drop["key"] = json!("owner-removes-prerequisites-explicitly");
        let owner = api.post(&api.fixture.owner, &drop).await;
        assert_eq!(
            owner.0, 200,
            "Owner may explicitly amend admitted authority: {}",
            owner.1
        );
        assert_eq!(owner.1["acceptance"], admitted.1["acceptance"]);
        let after: Value = api
            .client
            .get(read(dependent))
            .bearer_auth(&api.fixture.owner)
            .send()
            .await
            .unwrap()
            .json()
            .await
            .unwrap();
        assert_eq!(after["dependencies"], json!([]));
        probe["key"] = json!("grant-after-owner-amendment");
        let response = api
            .client
            .post(format!("{}/v1/commands", api.url))
            .bearer_auth(&api.fixture.owner)
            .json(&probe)
            .send()
            .await
            .unwrap();
        assert_eq!(
            response.status().as_u16(),
            200,
            "explicit Owner expansion positive control"
        );
        api.finish().await;
        return;
    }
    let ready=api.legacy_task(api.fixture.task).await;
    assert_eq!(ready["data"]["generation"],2);
    for (role,principal,token) in [("worker",api.fixture.worker,"research-worker-g3"),("verifier",api.fixture.verifier,"research-verifier-g3")] {
        assert_eq!(api.v1(&format!("renew-{role}"),0,None,json!({"kind":"grant_credential","credential_id":Uuid::new_v4(),"principal_id":principal,"role":role,"mission_id":api.fixture.mission,"task_id":api.fixture.task,"generation":3,"token_hash":token_hash(token),"expires_in_seconds":300})).await.0,200);
