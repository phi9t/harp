+    /// Fresh production consumes the current gate. Artifact Verify admits a
+    /// successful gate after failure only with a postfailure execution; selecting
+    /// that exact latest report also prevents older proofs from regaining authority
+    /// when a later fresh report clears the failure. Historical reads stay separate.
+    pub(crate) async fn verify_production_gate(
+        &self,
+        tx: &tokio_postgres::Transaction<'_>,
+        task: Uuid,
+        candidate: &str,
+        report: &str,
+    ) -> Result<()> {
+        let eligible: bool = tx.query_one(
+            "SELECT EXISTS(SELECT 1 FROM tasks t JOIN artifact_current a ON a.task_id=t.id WHERE t.id=$1 AND t.status='verifying' AND a.candidate_id=$2 AND $3=(SELECT e.payload->'result'->>'report_id' FROM events e WHERE e.aggregate_kind='task' AND e.aggregate_id=t.id AND e.kind='verification.submit' AND e.payload->'result'->>'candidate_id'=a.candidate_id ORDER BY e.sequence DESC LIMIT 1))",
+            &[&task, &candidate, &report],
+        ).await?.get(0);
+        if !eligible {
+            return Err(err(ErrorCode::DependencyUnmet));
+        }
+        Ok(())
+    }
