{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "state", "execution", "contract", "arguments"],
  "properties": {
    "schema": {"const": 1},
    "source": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"type": "string", "pattern": "^/"},
    "execution": {"type": "string", "pattern": "^/"},
    "contract": {"type": "string", "pattern": "^insula-durable-v1:[a-f0-9]{64}$"},
    "arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
