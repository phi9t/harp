{
  "name": "toolchains",
  "layers": [
    {
      "kind": "base",
      "source": "host-usr"
    },
    {
      "kind": "tree",
      "name": "uv",
      "copy": [
        {
          "from": "~/.local/bin/uv",
          "to": "bin/uv"
        }
      ],
      "path": [
        "bin"
      ]
    },
    {
      "kind": "host-ro",
      "name": "rust",
      "paths": [
        "~/.cargo/bin",
        "~/.rustup"
      ],
      "probe": [
        "~/.cargo/bin/cargo --version",
        "~/.cargo/bin/rustc --version"
      ],
      "path": [
        "~/.cargo/bin"
      ],
      "env": {
        "CARGO_HOME": "/home/bench/.cargo",
        "RUSTUP_HOME": "~/.rustup"
      }
    },
    {
      "kind": "host-ro",
      "name": "blade",
      "paths": [
        "/opt/tiger/typhoon-blade",
        "/opt/tiger/ss_bin"
      ],
      "probe": [
        "/opt/tiger/ss_bin/blade --version 2>/dev/null; stat -c %s /opt/tiger/typhoon-blade/executor"
      ]
    },
    {
      "kind": "tree",
      "name": "blade-tools",
      "source": "../layers/blade-tools",
      "path": [
        "bin"
      ]
    },
    {
      "kind": "host-ro",
      "name": "cuda",
      "paths": [
        "/usr/local/cuda"
      ],
      "probe": [
        "/usr/local/cuda/bin/nvcc --version | tail -1"
      ],
      "path": [
        "/usr/local/cuda/bin"
      ],
      "env": {
        "NVCC": "/usr/local/cuda/bin/nvcc",
        "CUDA_PATH": "/usr/local/cuda"
      }
    }
  ],
  "policy": {
    "net": "none",
    "gpu": false
  }
}
