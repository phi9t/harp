+fn changed_base_prepares_and_checks_actual_git_integration_candidate() {
+    let repo = std::env::temp_dir().join(format!("integration-fixture-{}", Uuid::new_v4()));
+    std::fs::create_dir_all(&repo).unwrap();
+    git(&repo, &["init", "-b", "fixture"]);
