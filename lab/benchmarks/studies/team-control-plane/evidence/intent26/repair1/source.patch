+//! Explicit current-lead delegation. Authentication alone conveys no admission.
+use super::*;
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Delegation {
+    pub id: Uuid,
+    pub principal: Uuid,
+    pub role_epoch: i64,
+    pub work: WorkRef,
+    pub families: Vec<String>,
+    pub effects: Vec<String>,
+    pub max_intents: i64,
+    pub max_plans: i64,
+    pub resources: Resources,
+    pub expires_in_seconds: i64,
+}
+async fn admitted(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    mission: Uuid,
+) -> Result<Delegation> {
+    let family = envelope.command.family();
+    let rows=tx.query("SELECT d.delegation FROM contract_delegations d JOIN mission_leads l ON l.mission_id=d.mission_id AND l.principal_id=d.principal_id AND l.generation=d.role_epoch JOIN contract_work w ON w.id=d.work_id WHERE d.task_id=$1 AND d.mission_id=$2 AND d.principal_id=$3 AND d.recovery_epoch=$4 AND d.expires_at>clock_timestamp() AND w.task_id=$1 ORDER BY d.expires_at DESC",&[&envelope.task,&mission,&actor.principal,&envelope.recovery_epoch]).await?;
+    for row in rows {
+        let delegation: Delegation = serde_json::from_value(row.get(0))
+            .map_err(|_| err(ErrorCode::TemporarilyUnavailable))?;
+        if delegation.families.iter().any(|f| f == family) {
+            return Ok(delegation);
+        }
+    }
+    Err(err(ErrorCode::Unauthorized))
+}
+pub(super) async fn authorize(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    mission: Uuid,
+) -> Result<()> {
+    if matches!(
+        envelope.command,
+        Command::ProposeOutcome { .. }
+            | Command::BindVerification { .. }
+            | Command::VerifyProduction { .. }
+            | Command::VerifyResearch { .. }
+    ) {
+        return outcomes::authorize(tx, actor, envelope).await;
+    }
+    if matches!(envelope.command, Command::ProposeSource { .. }) {
+        return Ok(());
+    }
+    if actor.role == Role::Owner {
+        return Ok(());
+    }
+    if actor.role != Role::Lead || matches!(envelope.command, Command::AdmitDelegation { .. }) {
+        return Err(err(ErrorCode::Unauthorized));
+    }
+    let delegation = admitted(tx, actor, envelope, mission).await?;
+    let (_, _, current) = strategy::current(tx, envelope.task).await?;
+    let counts=tx.query_one("SELECT (SELECT count(*) FROM contract_intents i JOIN contract_work w ON w.id=i.work_id WHERE w.task_id=$1),(SELECT count(*) FROM contract_plans WHERE task_id=$1)",&[&envelope.task]).await?;
+    // A replay is still a current authority decision. Owner amendments may
+    // exceed an earlier delegation, but they cannot silently enlarge it.
+    if counts.get::<_, i64>(0) > delegation.max_intents
+        || counts.get::<_, i64>(1) > delegation.max_plans
+        || !strategy::within(&current.resources, &delegation.resources)
+        || current
+            .allowed_effects
+            .iter()
+            .any(|e| !delegation.effects.contains(e))
+    {
+        return Err(err(ErrorCode::Unauthorized));
+    }
+    match &envelope.command {
+        Command::AdmitIntent { work, intent, .. } => {
+            // Outcome, acceptance and authority expansion always need Owner.
+            if work != &delegation.work
+                || intent.objective != current.objective
+                || intent.acceptance != current.acceptance
+                || intent.legacy_spec_digest != current.legacy_spec_digest
+                || current
+                    .constraints
+                    .iter()
+                    .any(|c| !intent.constraints.contains(c))
+                || intent.allowed_effects.iter().any(|e| {
+                    !current.allowed_effects.contains(e) || !delegation.effects.contains(e)
+                })
+                || !strategy::within(&intent.resources, &current.resources)
+                || !strategy::within(&intent.resources, &delegation.resources)
+            {
+                return Err(err(ErrorCode::Unauthorized));
+            }
+            // General intent delegation cannot discard or replace prerequisites.
+            // Use the current projection so an exact explicit revalidation is
+            // preserved even when the immutable original Intent predates it.
+            dependencies::preserve(tx, envelope.task, &intent.dependencies).await?;
+        }
+        Command::AdmitPlan { plan } => {
+            if plan
+                .allowed_effects
+                .iter()
+                .any(|e| !delegation.effects.contains(e))
+                || !strategy::within(&plan.resources, &delegation.resources)
+            {
+                return Err(err(ErrorCode::Unauthorized));
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+pub(super) async fn check_limit(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    intent: bool,
+) -> Result<()> {
+    if actor.role == Role::Owner {
+        return Ok(());
+    }
+    let mission: Uuid = tx
+        .query_one(
+            "SELECT mission_id FROM tasks WHERE id=$1",
+            &[&envelope.task],
+        )
+        .await?
+        .get(0);
+    let delegation = admitted(tx, actor, envelope, mission).await?;
+    let count: i64 = if intent {
+        tx.query_one("SELECT count(*) FROM contract_intents i JOIN contract_work w ON w.id=i.work_id WHERE w.task_id=$1",&[&envelope.task]).await?.get(0)
+    } else {
+        tx.query_one(
+            "SELECT count(*) FROM contract_plans WHERE task_id=$1",
+            &[&envelope.task],
+        )
+        .await?
+        .get(0)
+    };
+    if count
+        >= if intent {
+            delegation.max_intents
+        } else {
+            delegation.max_plans
+        }
+    {
+        return Err(err(ErrorCode::BudgetExhausted));
+    }
+    Ok(())
+}
+pub(super) async fn admit(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    mission: Uuid,
+    revision: i64,
+    delegation: &Delegation,
+) -> Result<Value> {
+    actor.owner()?;
+    let (_, _, intent) = strategy::current(tx, envelope.task).await?;
+    validate_work(&delegation.work)?;
+    let work_id = crate::validation::digest(&delegation.work)?;
+    if delegation.role_epoch <= 0
+        || delegation.max_intents < 1
+        || delegation.max_plans < 1
+        || !(1..=86400).contains(&delegation.expires_in_seconds)
+        || delegation.families.is_empty()
+        || !unique(&delegation.families)
+        || delegation.families.iter().any(|f| {
+            ![
+                "intent.admit",
+                "plan.admit",
+                "dependency.revalidate",
+                "outcome.accept",
+            ]
+            .contains(&f.as_str())
+        })
+        || !unique(&delegation.effects)
+        || delegation
+            .effects
+            .iter()
+            .any(|e| !intent.allowed_effects.contains(e))
+        || !strategy::within(&delegation.resources, &intent.resources)
+    {
+        return Err(err(ErrorCode::InvalidArgument));
+    }
+    if !tx.query_one("SELECT EXISTS(SELECT 1 FROM contract_work w JOIN mission_leads l ON l.mission_id=w.mission_id WHERE w.id=$1 AND w.task_id=$2 AND l.principal_id=$3 AND l.generation=$4)",&[&work_id,&envelope.task,&delegation.principal,&delegation.role_epoch]).await?.get::<_,bool>(0) {return Err(err(ErrorCode::StaleGeneration));}
+    if tx
+        .query_opt(
+            "SELECT id FROM contract_delegations WHERE id=$1",
+            &[&delegation.id],
+        )
+        .await?
+        .is_some()
+    {
+        return Err(err(ErrorCode::IdempotencyConflict));
+    }
+    tx.execute("INSERT INTO contract_delegations(id,task_id,mission_id,principal_id,role_epoch,work_id,delegation,by_principal,recovery_epoch,expires_at) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9,clock_timestamp()+($10::bigint*interval '1 second'))",&[&delegation.id,&envelope.task,&mission,&delegation.principal,&delegation.role_epoch,&work_id,&serde_json::to_value(delegation).map_err(|_|err(ErrorCode::InvalidArgument))?,&actor.principal,&envelope.recovery_epoch,&delegation.expires_in_seconds]).await?;
+    tx.execute(
+        "UPDATE contract_current SET revision=$2 WHERE task_id=$1",
+        &[&envelope.task, &(revision + 1)],
+    )
+    .await?;
+    Ok(
+        json!({"schema_version":2,"disposition":"applied","revision":revision+1,"delegation":delegation.id}),
+    )
+}
diff --git a/crates/team-control-plane/src/contracts/dependencies.rs b/crates/team-control-plane/src/contracts/dependencies.rs
new file mode 100644
index 0000000..332f444
--- /dev/null
+++ b/crates/team-control-plane/src/contracts/dependencies.rs
@@ -0,0 +1,145 @@
+//! Exact prerequisite proofs suspend fresh grants only on Broker admission.
+//! Previously recorded operations retain their receipts and reconciliation seam.
+use super::*;
+pub(super) async fn validate(
+    tx: &Transaction<'_>,
+    task: Uuid,
+    dependencies: &[Dependency],
+) -> Result<()> {
+    if dependencies.len() > 128 {
+        return Err(err(ErrorCode::InvalidArgument));
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    for dependency in dependencies {
+        validate_work(&dependency.work)?;
+        let work = crate::validation::digest(&dependency.work)?;
+        if !seen.insert(work.clone())
+            || !digest(&dependency.intent)
+            || !digest(&dependency.accepted_subject)
+            || !text(&dependency.policy)
+        {
+            return Err(err(ErrorCode::InvalidArgument));
+        }
+        let row=tx.query_opt("SELECT w.task_id,o.intent_id,o.policy,c.intent_id FROM contract_work w JOIN contract_outcomes o ON o.task_id=w.task_id JOIN contract_current c ON c.task_id=w.task_id WHERE w.id=$1 AND o.subject=$2",&[&work,&dependency.accepted_subject]).await?.ok_or_else(||err(ErrorCode::DependencyUnmet))?;
+        let prerequisite: Uuid = row.get(0);
+        if prerequisite == task
+            || row.get::<_, String>(1) != dependency.intent
+            || row.get::<_, String>(3) != dependency.intent
+            || row.get::<_, String>(2) != dependency.policy
+        {
+            return Err(err(ErrorCode::DependencyUnmet));
+        }
+        let cycle:bool=tx.query_one("WITH RECURSIVE reachable(task_id) AS (SELECT $1::uuid UNION SELECT w.task_id FROM reachable r JOIN contract_dependencies d ON d.task_id=r.task_id JOIN contract_work w ON w.id=d.prerequisite_work) SELECT EXISTS(SELECT 1 FROM reachable WHERE task_id=$2)",&[&prerequisite,&task]).await?.get(0);
+        if cycle {
+            return Err(err(ErrorCode::InvalidArgument));
+        }
+    }
+    Ok(())
+}
+pub(super) async fn replace(
+    tx: &Transaction<'_>,
+    task: Uuid,
+    dependencies: &[Dependency],
+) -> Result<()> {
+    tx.execute(
+        "DELETE FROM contract_dependencies WHERE task_id=$1",
+        &[&task],
+    )
+    .await?;
+    for dependency in dependencies {
+        let work = crate::validation::digest(&dependency.work)?;
+        tx.execute("INSERT INTO contract_dependencies(task_id,prerequisite_work,intent_id,accepted_subject,policy,disposition) VALUES($1,$2,$3,$4,$5,'active')",&[&task,&work,&dependency.intent,&dependency.accepted_subject,&dependency.policy]).await?;
+    }
+    Ok(())
+}
+pub(super) async fn preserve(
+    tx: &Transaction<'_>,
+    task: Uuid,
+    dependencies: &[Dependency],
+) -> Result<()> {
+    let current=tx.query("SELECT prerequisite_work,intent_id,accepted_subject,policy FROM contract_dependencies WHERE task_id=$1",&[&task]).await?;
+    for row in current {
+        let mut retained = false;
+        for dependency in dependencies {
+            if crate::validation::digest(&dependency.work)? == row.get::<_, String>(0)
+                && dependency.intent == row.get::<_, String>(1)
+                && dependency.accepted_subject == row.get::<_, String>(2)
+                && dependency.policy == row.get::<_, String>(3)
+            {
+                retained = true;
+                break;
+            }
+        }
+        if !retained {
+            return Err(err(ErrorCode::Unauthorized));
+        }
+    }
+    Ok(())
+}
+pub(super) async fn supersede(tx: &Transaction<'_>, work: &str, intent: &str) -> Result<()> {
+    // No source event/proposal calls this. Historical outcome and receipt rows
+    // stay immutable, even while their dependency projections become suspended.
+    let changed=tx.query("UPDATE contract_dependencies SET disposition='suspended' WHERE prerequisite_work=$1 AND intent_id<>$2 AND disposition='active' RETURNING task_id",&[&work,&intent]).await?;
+    for row in changed {
+        tx.execute(
+            "UPDATE contract_current SET revision=revision+1 WHERE task_id=$1",
+            &[&row.get::<_, Uuid>(0)],
+        )
+        .await?;
+    }
+    Ok(())
+}
+pub(super) async fn revalidate(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    revision: i64,
+    intent: &str,
+    dependencies: &[Dependency],
+) -> Result<Value> {
+    let (current, _, _) = strategy::current(tx, envelope.task).await?;
+    if current != intent {
+        return Err(err(ErrorCode::StaleRevision));
+    }
+    let old = tx
+        .query(
+            "SELECT prerequisite_work,policy FROM contract_dependencies WHERE task_id=$1",
+            &[&envelope.task],
+        )
+        .await?;
+    if old.len() != dependencies.len() {
+        return Err(err(ErrorCode::InvalidArgument));
+    }
+    for dependency in dependencies {
+        let work = crate::validation::digest(&dependency.work)?;
+        if !old
+            .iter()
+            .any(|r| r.get::<_, String>(0) == work && r.get::<_, String>(1) == dependency.policy)
+        {
+            return Err(err(ErrorCode::InvalidArgument));
+        }
+    }
+    validate(tx, envelope.task, dependencies).await?;
+    let id = crate::validation::digest(&(envelope.task, intent, dependencies, revision))?;
+    tx.execute("INSERT INTO contract_dependency_revalidations(id,task_id,intent_id,dependencies,principal_id,recovery_epoch) VALUES($1,$2,$3,$4,$5,$6)",&[&id,&envelope.task,&intent,&serde_json::to_value(dependencies).map_err(|_|err(ErrorCode::InvalidArgument))?,&actor.principal,&envelope.recovery_epoch]).await?;
+    replace(tx, envelope.task, dependencies).await?;
+    tx.execute(
+        "UPDATE contract_current SET revision=$2 WHERE task_id=$1",
+        &[&envelope.task, &(revision + 1)],
+    )
+    .await?;
+    Ok(json!({"schema_version":2,"disposition":"applied","revision":revision+1,"revalidation":id}))
+}
+pub(crate) async fn fresh_grant(tx: &Transaction<'_>, task: Uuid) -> Result<()> {
+    let Some(row)=tx.query_opt("SELECT c.admission_open,i.intent,t.spec_digest FROM contract_current c JOIN contract_intents i ON i.id=c.intent_id JOIN tasks t ON t.id=c.task_id WHERE c.task_id=$1",&[&task]).await? else {return Ok(());};
+    let intent: IntentRevision =
+        serde_json::from_value(row.get(1)).map_err(|_| err(ErrorCode::TemporarilyUnavailable))?;
+    if !row.get::<_, bool>(0) || row.get::<_, String>(2) != intent.legacy_spec_digest {
+        return Err(err(ErrorCode::DependencyUnmet));
+    }
+    let closed:bool=tx.query_one("SELECT EXISTS(SELECT 1 FROM contract_dependencies d JOIN contract_work w ON w.id=d.prerequisite_work JOIN contract_current c ON c.task_id=w.task_id WHERE d.task_id=$1 AND (d.disposition<>'active' OR d.intent_id<>c.intent_id)) OR EXISTS(SELECT 1 FROM contract_outcomes o JOIN contract_current c ON c.intent_id=o.intent_id WHERE c.task_id=$1)",&[&task]).await?.get(0);
+    if closed {
+        return Err(err(ErrorCode::DependencyUnmet));
+    }
+    Ok(())
+}
diff --git a/crates/team-control-plane/src/contracts/outcomes.rs b/crates/team-control-plane/src/contracts/outcomes.rs
new file mode 100644
index 0000000..6bafd38
--- /dev/null
+++ b/crates/team-control-plane/src/contracts/outcomes.rs
@@ -0,0 +1,436 @@
+//! v2 proof bindings retain v1 ArtifactService identities. Production requires
+//! a pre-execution exact binding and the existing independent monitor evidence.
+use super::*;
+use crate::artifacts::ArtifactService;
+
+fn service(service: Option<&ArtifactService>) -> Result<&ArtifactService> {
+    service.ok_or_else(|| err(ErrorCode::TemporarilyUnavailable))
+}
+fn expected(
+    intent: &str,
+    acceptance: &str,
+    policy: &str,
+    environment: &str,
+    current: &(String, String, IntentRevision),
+) -> Result<()> {
+    if intent != current.0
+        || acceptance != current.1
+        || policy != current.2.acceptance.policy
+        || environment != current.2.acceptance.environment
+    {
+        return Err(err(ErrorCode::StaleRevision));
+    }
+    Ok(())
+}
+pub(super) async fn authorize(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+) -> Result<()> {
+    match &envelope.command {
+        Command::ProposeOutcome { .. } => {
+            if !matches!(actor.role, Role::Owner | Role::Lead | Role::Worker) {
+                return Err(err(ErrorCode::Unauthorized));
+            }
+        }
+        Command::BindVerification { .. }
+        | Command::VerifyProduction { .. }
+        | Command::VerifyResearch { .. } => {
+            let (_, _, intent) = strategy::current(tx, envelope.task).await?;
+            if actor.role != Role::Verifier || actor.principal != intent.acceptance.verifier {
+                return Err(err(ErrorCode::Unauthorized));
+            }
+        }
+        _ => return Err(err(ErrorCode::Unauthorized)),
+    }
+    Ok(())
+}
+pub(super) async fn mutation_enabled(tx: &Transaction<'_>, envelope: &Envelope) -> Result<()> {
+    if matches!(
+        envelope.command,
+        Command::ProposeOutcome { .. }
+            | Command::BindVerification { .. }
+            | Command::VerifyProduction { .. }
+            | Command::VerifyResearch { .. }
+            | Command::AcceptOutcome { .. }
+    ) {
+        crate::kernel::task_dispatch_enabled(tx, envelope.task).await?;
+    }
+    Ok(())
+}
+pub(super) async fn apply(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    revision: i64,
+    artifacts: Option<&ArtifactService>,
+) -> Result<Value> {
+    let current = strategy::current(tx, envelope.task).await?;
+    match &envelope.command {
+        Command::ProposeOutcome {
+            intent,
+            evidence,
+            negative,
+            evaluator_change,
+        } => {
+            if intent != &current.0 {
+                return Err(err(ErrorCode::StaleRevision));
+            }
+            service(artifacts)?
+                .reference(tx, evidence, crate::artifacts::ReferenceFault::None)
+                .await?;
+            let proposal = json!({"intent":intent,"evidence":evidence,"negative":negative,"evaluator_change":evaluator_change});
+            let id = crate::validation::digest(&(envelope.task, actor.principal, &proposal))?;
+            tx.execute("INSERT INTO contract_proposals(id,task_id,principal_id,proposal,recovery_epoch) VALUES($1,$2,$3,$4,$5) ON CONFLICT DO NOTHING",&[&id,&envelope.task,&actor.principal,&proposal,&envelope.recovery_epoch]).await?;
+            Ok(
+                json!({"schema_version":2,"disposition":"proposed","revision":revision,"proposal":id}),
+            )
+        }
+        Command::BindVerification {
+            episode,
+            intent,
+            acceptance,
+            policy,
+            environment,
+        } => {
+            expected(intent, acceptance, policy, environment, &current)?;
+            if current.2.acceptance.outcome != Outcome::Production {
+                return Err(err(ErrorCode::DependencyUnmet));
+            }
+            let bound_contract = &current.2.acceptance;
+            let stored_policy=tx.query_opt("SELECT verifier,suite,environment,mandatory_commands FROM artifact_policies WHERE task_id=$1",&[&envelope.task]).await?.ok_or_else(||err(ErrorCode::DependencyUnmet))?;
+            if stored_policy.get::<_, Uuid>(0) != bound_contract.verifier
+                || stored_policy.get::<_, String>(1) != bound_contract.suite
+                || stored_policy.get::<_, String>(2) != bound_contract.environment
+                || stored_policy.get::<_, Value>(3)
+                    != serde_json::to_value(&bound_contract.mandatory_commands)
+                        .map_err(|_| err(ErrorCode::InvalidArgument))?
+            {
+                return Err(err(ErrorCode::StaleRevision));
+            }
+            // Binding a finished or already allocated episode would wrap an old
+            // v1 proof. Bind before any independently measured execution exists.
+            let eligible:bool=tx.query_one("SELECT EXISTS(SELECT 1 FROM mailbox_episodes e JOIN tasks t ON t.id=e.task_id JOIN kernel_verification_requirements r ON r.task_id=t.id WHERE e.id=$1 AND e.task_id=$2 AND e.principal_id=$3 AND e.role='verifier' AND e.purpose='verification' AND e.state='admitted' AND e.task_generation=t.generation AND e.recovery_epoch=$4 AND r.recovery_epoch=$4 AND e.deadline>clock_timestamp() AND NOT EXISTS(SELECT 1 FROM episode_executions x WHERE x.episode_id=e.id) AND NOT EXISTS(SELECT 1 FROM contract_verification_bindings b WHERE b.episode_id=e.id))",&[&episode,&envelope.task,&actor.principal,&envelope.recovery_epoch]).await?.get(0);
+            if !eligible {
+                return Err(err(ErrorCode::DependencyUnmet));
+            }
+            let id = crate::validation::digest(&(
+                envelope.task,
+                episode,
+                intent,
+                acceptance,
+                policy,
+                environment,
+                actor.principal,
+                envelope.recovery_epoch,
+            ))?;
+            tx.execute("INSERT INTO contract_verification_bindings(id,task_id,episode_id,intent_id,acceptance_id,verifier,policy,environment,recovery_epoch) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)",&[&id,&envelope.task,episode,intent,acceptance,&actor.principal,policy,environment,&envelope.recovery_epoch]).await?;
+            bump(tx, envelope.task, revision).await?;
+            Ok(
+                json!({"schema_version":2,"disposition":"applied","revision":revision+1,"binding":id}),
+            )
+        }
+        Command::VerifyProduction {
+            binding,
+            candidate,
+            report,
+        } => {
+            let evidence = json!({"binding":binding,"candidate":candidate,"report":report});
+            production_evidence(
+                tx,
+                envelope.task,
+                &current,
+                actor.principal,
+                &evidence,
+                service(artifacts)?,
+            )
+            .await?;
+            persist_proof(
+                tx,
+                actor,
+                envelope,
+                revision,
+                &current,
+                "production",
+                evidence,
+            )
+            .await
+        }
+        Command::VerifyResearch {
+            intent,
+            acceptance,
+            proposal,
+            policy,
+            environment,
+        } => {
+            expected(intent, acceptance, policy, environment, &current)?;
+            let evidence = json!({"proposal":proposal});
+            research_evidence(
+                tx,
+                envelope.task,
+                &current,
+                actor.principal,
+                &evidence,
+                service(artifacts)?,
+            )
+            .await?;
+            persist_proof(
+                tx,
+                actor,
+                envelope,
+                revision,
+                &current,
+                "investigation_complete",
+                evidence,
+            )
+            .await
+        }
+        Command::AcceptOutcome { proof } => {
+            let row=tx.query_opt("SELECT intent_id,acceptance_id,verifier,outcome,evidence FROM contract_proofs WHERE id=$1 AND task_id=$2",&[proof,&envelope.task]).await?.ok_or_else(||err(ErrorCode::DependencyUnmet))?;
+            let intent: String = row.get(0);
+            let acceptance: String = row.get(1);
+            let verifier: Uuid = row.get(2);
+            let outcome: String = row.get(3);
+            let evidence: Value = row.get(4);
+            if intent != current.0
+                || acceptance != current.1
+                || verifier != current.2.acceptance.verifier
+            {
+                return Err(err(ErrorCode::StaleRevision));
+            }
+            if actor.principal == verifier {
+                return Err(err(ErrorCode::Unauthorized));
+            }
+            if outcome == "production" {
+                production_evidence(
+                    tx,
+                    envelope.task,
+                    &current,
+                    verifier,
+                    &evidence,
+                    service(artifacts)?,
+                )
+                .await?;
+            } else {
+                research_evidence(
+                    tx,
+                    envelope.task,
+                    &current,
+                    verifier,
+                    &evidence,
+                    service(artifacts)?,
+                )
+                .await?;
+            }
+            if tx
+                .query_opt(
+                    "SELECT subject FROM contract_outcomes WHERE task_id=$1 AND intent_id=$2",
+                    &[&envelope.task, &current.0],
+                )
+                .await?
+                .is_some()
+            {
+                return Err(err(ErrorCode::StaleRevision));
+            }
+            let subject = crate::validation::digest(&(
+                envelope.task,
+                &current.0,
+                &current.1,
+                proof,
+                &outcome,
+                &current.2.acceptance.policy,
+            ))?;
+            tx.execute("INSERT INTO contract_outcomes(subject,task_id,intent_id,proof_id,outcome,policy,by_principal,recovery_epoch) VALUES($1,$2,$3,$4,$5,$6,$7,$8)",&[&subject,&envelope.task,&current.0,proof,&outcome,&current.2.acceptance.policy,&actor.principal,&envelope.recovery_epoch]).await?;
+            if outcome == "production" {
+                let report = evidence["report"]
+                    .as_str()
+                    .ok_or_else(|| err(ErrorCode::DependencyUnmet))?;
+                tx.execute(
+                    "UPDATE artifact_current SET accepted_report=$2 WHERE task_id=$1",
+                    &[&envelope.task, &report],
+                )
+                .await?;
+                let legacy_revision:i64=tx.query_one("UPDATE tasks SET status='accepted',revision=revision+1 WHERE id=$1 RETURNING revision",&[&envelope.task]).await?.get(0);
+                let event = Uuid::new_v4();
+                tx.execute("INSERT INTO events(id,aggregate_kind,aggregate_id,sequence,version,principal_id,transaction_id,kind,payload) VALUES($1,'task',$2,$3,1,$4,txid_current(),'task.accept.v2',$5)",&[&event,&envelope.task,&legacy_revision,&actor.principal,&json!({"intent":current.0,"acceptance":current.1,"proof":proof,"subject":subject})]).await?;
+            }
+            bump(tx, envelope.task, revision).await?;
+            Ok(
+                json!({"schema_version":2,"disposition":"applied","revision":revision+1,"subject":subject,"proof":proof,"outcome":outcome}),
+            )
+        }
+        _ => Err(err(ErrorCode::InvalidArgument)),
+    }
+}
+async fn bump(tx: &Transaction<'_>, task: Uuid, revision: i64) -> Result<()> {
+    tx.execute(
+        "UPDATE contract_current SET revision=$2 WHERE task_id=$1",
+        &[&task, &(revision + 1)],
+    )
+    .await?;
+    Ok(())
+}
+async fn persist_proof(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    revision: i64,
+    current: &(String, String, IntentRevision),
+    outcome: &str,
+    evidence: Value,
+) -> Result<Value> {
+    let id = crate::validation::digest(&(
+        envelope.task,
+        &current.0,
+        &current.1,
+        actor.principal,
+        outcome,
+        &evidence,
+    ))?;
+    if tx
+        .query_opt("SELECT id FROM contract_proofs WHERE id=$1", &[&id])
+        .await?
+        .is_some()
+    {
+        return Err(err(ErrorCode::StaleRevision));
+    }
+    tx.execute("INSERT INTO contract_proofs(id,task_id,intent_id,acceptance_id,verifier,outcome,evidence) VALUES($1,$2,$3,$4,$5,$6,$7)",&[&id,&envelope.task,&current.0,&current.1,&actor.principal,&outcome,&evidence]).await?;
+    bump(tx, envelope.task, revision).await?;
+    Ok(
+        json!({"schema_version":2,"disposition":"applied","revision":revision+1,"proof":id,"outcome":outcome}),
+    )
+}
+async fn research_evidence(
+    tx: &Transaction<'_>,
+    task: Uuid,
+    current: &(String, String, IntentRevision),
+    verifier: Uuid,
+    evidence: &Value,
+    artifacts: &ArtifactService,
+) -> Result<()> {
+    if current.2.acceptance.outcome != Outcome::InvestigationComplete {
+        return Err(err(ErrorCode::DependencyUnmet));
+    }
+    let proposal = evidence["proposal"]
+        .as_str()
+        .ok_or_else(|| err(ErrorCode::DependencyUnmet))?;
+    let row = tx
+        .query_opt(
+            "SELECT principal_id,proposal FROM contract_proposals WHERE id=$1 AND task_id=$2",
+            &[&proposal, &task],
+        )
+        .await?
+        .ok_or_else(|| err(ErrorCode::DependencyUnmet))?;
+    let body: Value = row.get(1);
+    if row.get::<_, Uuid>(0) == verifier
+        || verifier != current.2.acceptance.verifier
+        || body["intent"] != current.0
+        || body["evaluator_change"] != false
+        || (body["negative"] == true && !current.2.acceptance.allow_negative)
+    {
+        return Err(err(ErrorCode::DependencyUnmet));
+    }
+    artifacts.store().read(
+        body["evidence"]
+            .as_str()
+            .ok_or_else(|| err(ErrorCode::DependencyUnmet))?,
+    )?;
+    Ok(())
+}
+async fn production_evidence(
+    tx: &Transaction<'_>,
+    task: Uuid,
+    current: &(String, String, IntentRevision),
+    verifier: Uuid,
+    evidence: &Value,
+    artifacts: &ArtifactService,
+) -> Result<()> {
+    if current.2.acceptance.outcome != Outcome::Production {
+        return Err(err(ErrorCode::DependencyUnmet));
+    }
+    let binding = evidence["binding"]
+        .as_str()
+        .ok_or_else(|| err(ErrorCode::DependencyUnmet))?;
+    let candidate = evidence["candidate"]
+        .as_str()
+        .ok_or_else(|| err(ErrorCode::DependencyUnmet))?;
+    let report = evidence["report"]
+        .as_str()
+        .ok_or_else(|| err(ErrorCode::DependencyUnmet))?;
+    let bound=tx.query_opt("SELECT b.episode_id,b.intent_id,b.acceptance_id,b.policy,b.environment FROM contract_verification_bindings b JOIN kernel_verification_requirements r ON r.task_id=b.task_id WHERE b.id=$1 AND b.task_id=$2 AND b.verifier=$3 AND b.recovery_epoch=(SELECT active_epoch FROM deployment) AND r.recovery_epoch=b.recovery_epoch",&[&binding,&task,&verifier]).await?.ok_or_else(||err(ErrorCode::DependencyUnmet))?;
+    expected(
+        &bound.get::<_, String>(1),
+        &bound.get::<_, String>(2),
+        &bound.get::<_, String>(3),
+        &bound.get::<_, String>(4),
+        current,
+    )?;
+    let (subject, verification, origin) = artifacts.verify_evidence(tx, candidate, report).await?;
+    let acceptance = &current.2.acceptance;
+    let exact:bool=tx.query_one("SELECT EXISTS(SELECT 1 FROM artifact_current a JOIN artifact_candidates c ON c.id=a.candidate_id WHERE a.task_id=$1 AND a.candidate_id=$2 AND c.implementer<>$3)",&[&task,&candidate,&verifier]).await?.get(0);
+    if !exact
+        || origin != verifier
+        || subject.spec_digest != current.2.legacy_spec_digest
+        || verification.suite != acceptance.suite
+        || verification.environment != acceptance.environment
+        || !verification.resolved_decisions
+        || !subject.risks.is_empty()
+        || verification.checks.iter().any(|c| c.exit_code != 0)
+        || acceptance
+            .mandatory_commands
+            .iter()
+            .any(|c| !verification.checks.iter().any(|check| &check.command == c))
+    {
+        return Err(err(ErrorCode::DependencyUnmet));
+    }
+    let episode: Uuid = bound.get(0);
+    for check in &verification.checks {
+        let bytes = artifacts.store().read(&check.logs)?;
+        let measured: Value =
+            serde_json::from_slice(&bytes).map_err(|_| err(ErrorCode::DependencyUnmet))?;
+        let execution: Uuid =
+            serde_json::from_value(measured["trusted_monitor_result"]["execution"].clone())
+                .map_err(|_| err(ErrorCode::DependencyUnmet))?;
+        if !tx.query_one("SELECT EXISTS(SELECT 1 FROM episode_executions x WHERE x.execution_id=$1 AND x.episode_id=$2 AND x.task_id=$3 AND x.principal_id=$4 AND x.role='verifier')",&[&execution,&episode,&task,&verifier]).await?.get::<_,bool>(0) {return Err(err(ErrorCode::DependencyUnmet));}
+    }
+    Ok(())
+}
+pub(super) async fn replay(
+    tx: &Transaction<'_>,
+    envelope: &Envelope,
+    artifacts: Option<&ArtifactService>,
+) -> Result<()> {
+    let proof = match &envelope.command {
+        Command::AcceptOutcome { proof } => Some(proof.as_str()),
+        _ => None,
+    };
+    if let Some(proof) = proof {
+        let row=tx.query_opt("SELECT verifier,outcome,evidence,intent_id,acceptance_id FROM contract_proofs WHERE id=$1 AND task_id=$2",&[&proof,&envelope.task]).await?.ok_or_else(||err(ErrorCode::DependencyUnmet))?;
+        let current = strategy::current(tx, envelope.task).await?;
+        if row.get::<_, String>(3) != current.0 || row.get::<_, String>(4) != current.1 {
+            return Err(err(ErrorCode::StaleRevision));
+        }
+        if row.get::<_, String>(1) == "production" {
+            production_evidence(
+                tx,
+                envelope.task,
+                &current,
+                row.get(0),
+                &row.get(2),
+                service(artifacts)?,
+            )
+            .await?;
+        } else {
+            research_evidence(
+                tx,
+                envelope.task,
+                &current,
+                row.get(0),
+                &row.get(2),
+                service(artifacts)?,
+            )
+            .await?;
+        }
+    }
+    Ok(())
+}
diff --git a/crates/team-control-plane/src/contracts/strategy.rs b/crates/team-control-plane/src/contracts/strategy.rs
new file mode 100644
index 0000000..7193fec
--- /dev/null
+++ b/crates/team-control-plane/src/contracts/strategy.rs
@@ -0,0 +1,175 @@
+//! Declarative Plan admission only; this module never evaluates or runs code.
+use super::*;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Step {
+    pub id: String,
+    pub kind: String,
+    pub depends_on: Vec<String>,
+    pub join: String,
+    pub effects: Vec<String>,
+    pub max_iterations: i64,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct PlanRevision {
+    pub schema_version: u32,
+    pub interpreter_version: String,
+    pub intent: String,
+    pub acceptance: String,
+    pub allowed_effects: Vec<String>,
+    pub resources: Resources,
+    pub max_repairs: i64,
+    pub steps: Vec<Step>,
+}
+pub(super) fn within(actual: &Resources, limit: &Resources) -> bool {
+    actual.attempts > 0
+        && actual.episodes > 0
+        && actual.repairs >= 0
+        && actual.execution_seconds > 0
+        && actual.attempts <= limit.attempts
+        && actual.episodes <= limit.episodes
+        && actual.repairs <= limit.repairs
+        && actual.execution_seconds <= limit.execution_seconds
+}
+pub(super) async fn current(
+    tx: &Transaction<'_>,
+    task: Uuid,
+) -> Result<(String, String, IntentRevision)> {
+    let row=tx.query_opt("SELECT i.id,i.acceptance_id,i.intent FROM contract_current c JOIN contract_intents i ON i.id=c.intent_id WHERE c.task_id=$1 AND c.admission_open",&[&task]).await?.ok_or_else(||err(ErrorCode::DependencyUnmet))?;
+    Ok((
+        row.get(0),
+        row.get(1),
+        serde_json::from_value(row.get(2)).map_err(|_| err(ErrorCode::TemporarilyUnavailable))?,
+    ))
+}
+fn validate(plan: &PlanRevision) -> Result<()> {
+    if plan.schema_version != 1
+        || plan.interpreter_version != "declarative-v1"
+        || plan.steps.is_empty()
+        || plan.steps.len() > 128
+        || plan.allowed_effects.is_empty()
+        || !unique(&plan.allowed_effects)
+        || plan.max_repairs < 0
+        || plan.max_repairs > plan.resources.repairs
+    {
+        return Err(err(ErrorCode::InvalidArgument));
+    }
+    let mut steps = BTreeMap::new();
+    for step in &plan.steps {
+        if !text(&step.id)
+            || step.id.len() > 128
+            || steps.insert(&step.id, step).is_some()
+            || !["action", "join", "loop", "repair"].contains(&step.kind.as_str())
+            || !["all", "any"].contains(&step.join.as_str())
+            || !unique(&step.depends_on)
+            || !unique(&step.effects)
+            || step
+                .effects
+                .iter()
+                .any(|e| !plan.allowed_effects.contains(e))
+            || step.max_iterations <= 0
+            || step.max_iterations > 128
+            || (step.kind != "loop" && step.max_iterations != 1)
+            || (step.kind == "repair" && plan.max_repairs == 0)
+            || (step.kind == "join" && (step.depends_on.is_empty() || !step.effects.is_empty()))
+        {
+            return Err(err(ErrorCode::InvalidArgument));
+        }
+    }
+    let mut completed = BTreeSet::new();
+    loop {
+        let before = completed.len();
+        for step in &plan.steps {
+            if step.depends_on.iter().any(|id| !steps.contains_key(id)) {
+                return Err(err(ErrorCode::InvalidArgument));
+            }
+            if step.depends_on.iter().all(|id| completed.contains(id)) {
+                completed.insert(step.id.clone());
+            }
+        }
+        if completed.len() == plan.steps.len() {
+            return Ok(());
+        }
+        if completed.len() == before {
+            return Err(err(ErrorCode::InvalidArgument));
+        }
+    }
+}
+pub(super) async fn admit(
+    tx: &Transaction<'_>,
+    actor: &auth::Actor,
+    envelope: &Envelope,
+    revision: i64,
+    plan: &PlanRevision,
+) -> Result<Value> {
+    validate(plan)?;
+    let (intent_id, acceptance_id, intent) = current(tx, envelope.task).await?;
+    if plan.intent != intent_id || plan.acceptance != acceptance_id {
+        return Err(err(ErrorCode::StaleRevision));
+    }
+    if plan
+        .allowed_effects
+        .iter()
+        .any(|e| !intent.allowed_effects.contains(e))
+    {
+        return Err(err(ErrorCode::Unauthorized));
+    }
+    if !within(&plan.resources, &intent.resources) {
+        return Err(err(ErrorCode::BudgetExhausted));
+    }
+    if let Some(row)=tx.query_opt("SELECT p.plan FROM contract_current c JOIN contract_plans p ON p.id=c.plan_id WHERE c.task_id=$1",&[&envelope.task]).await? {
+        let previous:PlanRevision=serde_json::from_value(row.get(0)).map_err(|_|err(ErrorCode::TemporarilyUnavailable))?;
+        if !within(&plan.resources,&previous.resources) || plan.max_repairs>previous.max_repairs {return Err(err(ErrorCode::BudgetExhausted));}
+        if plan.allowed_effects.iter().any(|e|!previous.allowed_effects.contains(e)) {return Err(err(ErrorCode::Unauthorized));}
+    }
+    // All earlier consumed steps survive strategy replacement. Their meaning
+    // cannot depend on the latest plan or on a replaced interpreter.
+    for row in tx
+        .query(
+            "SELECT step_id,step FROM contract_completed_steps WHERE task_id=$1",
+            &[&envelope.task],
+        )
+        .await?
+    {
+        let id: String = row.get(0);
+        let stored: Value = row.get(1);
+        if plan
+            .steps
+            .iter()
+            .find(|s| s.id == id)
+            .and_then(|s| serde_json::to_value(s).ok())
+            .as_ref()
+            != Some(&stored)
+        {
+            return Err(err(ErrorCode::StaleRevision));
+        }
+    }
+    authority::check_limit(tx, actor, envelope, false).await?;
+    let id = crate::validation::digest(&(envelope.task, plan))?;
+    if tx
+        .query_opt("SELECT id FROM contract_plans WHERE id=$1", &[&id])
+        .await?
+        .is_some()
+    {
+        return Err(err(ErrorCode::StaleRevision));
+    }
+    let version: i64 = tx
+        .query_one(
+            "SELECT count(*)+1 FROM contract_plans WHERE task_id=$1",
+            &[&envelope.task],
+        )
+        .await?
+        .get(0);
+    tx.execute("INSERT INTO contract_plans(id,task_id,intent_id,acceptance_id,admitted_version,plan,principal_id,recovery_epoch) VALUES($1,$2,$3,$4,$5,$6,$7,$8)",&[&id,&envelope.task,&intent_id,&acceptance_id,&version,&serde_json::to_value(plan).map_err(|_|err(ErrorCode::InvalidArgument))?,&actor.principal,&envelope.recovery_epoch]).await?;
+    tx.execute(
+        "UPDATE contract_current SET revision=$2,plan_id=$3 WHERE task_id=$1",
+        &[&envelope.task, &(revision + 1), &id],
+    )
+    .await?;
+    Ok(
+        json!({"schema_version":2,"disposition":"applied","revision":revision+1,"plan":id,"admitted_version":version}),
+    )
+}
diff --git a/crates/team-control-plane/tests/intent_contracts.rs b/crates/team-control-plane/tests/intent_contracts.rs
