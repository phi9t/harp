@@ -0,0 +1,530 @@
+//! Exact admitted work and strategy, independent of mutable planning sources.
+//! PostgreSQL serializes authorization, revision checking, replay and mutation.
+use crate::{Broker, ErrorCode, Result, Role, auth, domain::err, storage};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use tokio_postgres::Transaction;
+use uuid::Uuid;
+mod authority;
+mod dependencies;
+pub(crate) use dependencies::fresh_grant;
+mod outcomes;
+mod strategy;
+pub use authority::Delegation;
+pub use strategy::{PlanRevision, Step};
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct WorkRef {
+    pub ledger: String,
+    pub deployment: String,
+    pub tenant: String,
+    pub project: String,
+    pub item: String,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct SourceSnapshot {
+    pub adapter: String,
+    pub locator: String,
+    pub revision: String,
+    pub availability: String,
+    pub snapshot: Vec<u8>,
+    pub digest: String,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Resources {
+    pub attempts: i64,
+    pub episodes: i64,
+    pub repairs: i64,
+    pub execution_seconds: i64,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum Outcome {
+    Production,
+    InvestigationComplete,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct AcceptanceContract {
+    pub outcome: Outcome,
+    pub allow_negative: bool,
+    pub criteria: Vec<String>,
+    pub verifier: Uuid,
+    pub policy: String,
+    pub suite: String,
+    pub environment: String,
+    pub mandatory_commands: Vec<Vec<String>>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Dependency {
+    pub work: WorkRef,
+    pub intent: String,
+    pub accepted_subject: String,
+    pub policy: String,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
