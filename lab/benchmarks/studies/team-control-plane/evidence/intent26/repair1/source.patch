+        capacity_before["missions"][0]["used_capacity"]
+    );
+    assert_eq!(
+        capacity_after["missions"][0]["admitted_attempts"],
+        capacity_before["missions"][0]["admitted_attempts"]
+    );
+    assert_eq!(read_status, evidence_read_before);
+    assert_eq!(retained_bytes.as_slice(), bytes);
