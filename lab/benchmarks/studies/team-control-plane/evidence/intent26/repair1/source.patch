+        .await;
+    assert_eq!(response.1["code"], "stale_revision");
+    let mut revised = plan;
+    revised["steps"].as_array_mut().unwrap().push(json!({"id":"review","kind":"action","depends_on":["produce"],"join":"all","effects":["read"],"max_iterations":1}));
+    assert_eq!(
