+pub(super) async fn preserve(
+    tx: &Transaction<'_>,
+    task: Uuid,
+    dependencies: &[Dependency],
+) -> Result<()> {
+    let current=tx.query("SELECT prerequisite_work,intent_id,accepted_subject,policy FROM contract_dependencies WHERE task_id=$1",&[&task]).await?;
+    for row in current {
+        let mut retained = false;
+        for dependency in dependencies {
+            if crate::validation::digest(&dependency.work)? == row.get::<_, String>(0)
+                && dependency.intent == row.get::<_, String>(1)
+                && dependency.accepted_subject == row.get::<_, String>(2)
+                && dependency.policy == row.get::<_, String>(3)
+            {
+                retained = true;
+                break;
+            }
+        }
+        if !retained {
+            return Err(err(ErrorCode::Unauthorized));
+        }
+    }
+    Ok(())
+}
