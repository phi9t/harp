        mission: Uuid,
        expected_generation: i64,
        principal: Uuid,
        credential_id: Uuid,
        token_hash: String,
        expires_in_seconds: i64,
    },
    Send {
        mission: Uuid,
        id: Uuid,
        recipients: Vec<Recipient>,
        message_kind: MessageKind,
