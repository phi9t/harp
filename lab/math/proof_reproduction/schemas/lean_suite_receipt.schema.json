{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crouzeix-lean-suite-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "runtime_id",
    "suite_id",
    "runtime_lock_sha256",
    "suite_manifest_sha256",
    "source_inventory_sha256",
    "runtime_inventory_sha256",
    "artifact_inventory_sha256",
    "execution_root_sha256",
    "command_receipts",
    "module_outcomes",
    "outcome",
    "reason",
    "lean_suite_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "crouzeix-lean-suite-receipt/v1"
    },
    "run_id": {
      "$ref": "#/$defs/safe_id"
    },
    "runtime_id": {
      "$ref": "#/$defs/safe_id"
    },
    "suite_id": {
      "$ref": "#/$defs/safe_id"
    },
    "runtime_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "suite_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_root_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "command_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command_receipt"
      }
    },
    "module_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module_outcome"
      }
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "lean_suite_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "command_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "argv",
        "cwd",
        "env",
        "timeout_seconds",
        "exit_code",
        "stdout_path",
        "stdout_sha256",
        "stderr_path",
        "stderr_sha256"
      ],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/safe_id"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "env": {
          "$ref": "#/$defs/env"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -255,
          "maximum": 255
        },
        "stdout_path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "module_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "outcome",
        "reason"
      ],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/safe_id"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
