{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "candidate_path"],
  "properties": {
    "schema_version": {
      "const": "crouzeix-historical-final/v1"
    },
    "status": {
      "enum": ["candidate_written", "no_candidate"]
    },
    "candidate_path": {
      "type": ["string", "null"],
      "maxLength": 128
    }
  }
}
