{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "critic_role", "candidate_sha256", "findings"],
  "properties": {
    "schema_version": {"const": "crouzeix-critic/v1"},
    "critic_role": {"enum": ["logical", "operator_theory"]},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "locator", "statement", "test"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F-[A-Z]+-[0-9]{3}$"},
          "severity": {"enum": ["critical", "major", "minor"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 512},
          "statement": {"type": "string", "minLength": 1, "maxLength": 8000},
          "test": {"type": "string", "minLength": 1, "maxLength": 8000}
        }
      }
    }
  }
}
