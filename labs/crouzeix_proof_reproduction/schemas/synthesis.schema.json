{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_route_ids",
    "candidate_proof",
    "obligations"
  ],
  "properties": {
    "schema_version": {"const": "crouzeix-synthesis/v1"},
    "parent_route_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^route-[1-9][0-9]*$"}
    },
    "candidate_proof": {"type": "string", "minLength": 1, "maxLength": 250000},
    "obligations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "strength", "status"],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
          "strength": {"enum": ["local", "major", "theorem_strength"]},
          "status": {"enum": ["proved", "unproved"]}
        }
      }
    }
  }
}
