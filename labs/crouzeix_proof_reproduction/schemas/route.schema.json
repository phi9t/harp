{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "family",
    "mechanism",
    "proved_statements",
    "unproved_obligations",
    "circularity_risks",
    "candidate_proof",
    "blocker",
    "confidence_basis"
  ],
  "properties": {
    "schema_version": {"const": "crouzeix-route/v1"},
    "route_id": {"type": "string", "pattern": "^route-[1-9][0-9]*$"},
    "family": {"type": "string", "minLength": 1, "maxLength": 256},
    "mechanism": {"type": "string", "minLength": 1, "maxLength": 12000},
    "proved_statements": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    },
    "unproved_obligations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "strength"],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
          "strength": {"enum": ["local", "major", "theorem_strength"]}
        }
      }
    },
    "circularity_risks": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    },
    "candidate_proof": {"type": ["string", "null"], "maxLength": 200000},
    "blocker": {"type": ["string", "null"], "maxLength": 12000},
    "confidence_basis": {"type": "string", "minLength": 1, "maxLength": 4000}
  }
}
