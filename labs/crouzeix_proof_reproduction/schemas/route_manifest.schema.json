{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harp.local/schemas/crouzeix-route-proof-manifest-v1.json",
  "title": "Crouzeix route proof manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "route_id", "claim_kind", "aggregate_module",
    "build_target", "terminal_declaration", "terminal_type_sha256",
    "consequence_declarations", "source_identities", "shared_foundation_modules",
    "module_closure", "module_closure_sha256", "allowed_axioms",
    "review_path", "review_sha256", "receipt_path", "receipt_sha256", "nodes"
  ],
  "properties": {
    "schema_version": {"const": "crouzeix-route-proof-manifest/v1"},
    "route_id": {"enum": ["jin", "lorist-schwenninger", "harp"]},
    "claim_kind": {"enum": ["source-faithful", "derived"]},
    "aggregate_module": {"$ref": "#/$defs/module"},
    "build_target": {"$ref": "#/$defs/module"},
    "terminal_declaration": {"$ref": "#/$defs/module"},
    "terminal_type_sha256": {"$ref": "#/$defs/sha256"},
    "consequence_declarations": {"$ref": "#/$defs/modules"},
    "source_identities": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|arxiv:[0-9]{4}\\.[0-9]{4,5}v[1-9][0-9]*)$", "maxLength": 71}
    },
    "shared_foundation_modules": {"$ref": "#/$defs/modulesMaybeEmpty"},
    "module_closure": {"$ref": "#/$defs/modules"},
    "module_closure_sha256": {"$ref": "#/$defs/sha256"},
    "allowed_axioms": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"enum": ["Classical.choice", "Quot.sound", "propext"]}
    },
    "review_path": {"$ref": "#/$defs/path"},
    "review_sha256": {"$ref": "#/$defs/nullableSha256"},
    "receipt_path": {"$ref": "#/$defs/path"},
    "receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
    "route_dependencies": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/routeDependency"}
    },
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"route_id": {"enum": ["jin", "lorist-schwenninger"]}}, "required": ["route_id"]},
      "then": {
        "properties": {
          "claim_kind": {"const": "source-faithful"},
          "source_identities": {"minItems": 1},
          "route_dependencies": {"maxItems": 0},
          "nodes": {
            "contains": {"properties": {"provenance_kind": {"const": "source"}}, "required": ["provenance_kind"]},
            "items": {"allOf": [{"$ref": "#/$defs/node"}, {"properties": {"provenance_kind": {"enum": ["source", "derived"]}}}]}
          }
        }
      }
    },
    {
      "if": {"properties": {"route_id": {"const": "harp"}}, "required": ["route_id"]},
      "then": {
        "properties": {
          "claim_kind": {"const": "derived"},
          "source_identities": {"maxItems": 0},
          "route_dependencies": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/routeDependency"},
                {
                  "properties": {
                    "route_id": {"const": "lorist-schwenninger"},
                    "manifest_path": {"const": "labs/crouzeix_proof_reproduction/formal_targets/lorist-schwenninger/route-manifest.json"},
                    "manifest_sha256": {"const": "c8c4aa731781015a356b0cc43f080df36a9d489a0b60700fea8e331c5993fbaa"},
                    "receipt_path": {"const": "evidence/crouzeix_conjecture/routes/lorist-schwenninger/receipt.json"},
                    "receipt_sha256": {"const": "f672bb002c9d7ebc516683d61ba87b2c1ff2bed891daac0e6781aeb50cc7a01b"}
                  },
                  "required": ["route_id", "manifest_path", "manifest_sha256", "receipt_path", "receipt_sha256"]
                }
              ]
            }
          },
          "nodes": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/node"},
                {
                  "if": {
                    "properties": {
                      "provenance_kind": {"const": "reused-route"},
                      "reused_node_id": {"type": "null"}
                    },
                    "required": ["provenance_kind", "reused_node_id"]
                  },
                  "then": {
                    "properties": {
                      "reused_from_route": {"const": "lorist-schwenninger"},
                      "module_path": {
                        "enum": [
                          "Crouzeix/LoristSchwenninger/BoundaryEmbedding.lean",
                          "Crouzeix/LoristSchwenninger/BoundaryMultiplier.lean",
                          "Crouzeix/LoristSchwenninger/BoundarySquareRoot.lean",
                          "Crouzeix/LoristSchwenninger/CompanionAlgebra.lean",
                          "Crouzeix/LoristSchwenninger/CompletedSquare.lean",
                          "Crouzeix/LoristSchwenninger/CompressionMoments.lean",
                          "Crouzeix/LoristSchwenninger/Dilation.lean",
                          "Crouzeix/LoristSchwenninger/NormAttainment.lean",
                          "Crouzeix/LoristSchwenninger/PolynomialPowerCauchy.lean",
                          "Crouzeix/LoristSchwenninger/Recurrence.lean",
                          "Crouzeix/LoristSchwenninger/Scalar.lean"
                        ]
                      }
                    },
                    "required": ["reused_from_route", "module_path"]
                  }
                }
              ]
            }
          }
        },
        "required": ["route_dependencies"]
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$", "maxLength": 1024},
    "path": {"type": "string", "pattern": "^(?!/)(?!\\\\)(?![^/]*:)(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+(?:/(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+)*$", "maxLength": 4096},
    "locator": {
      "oneOf": [
        {"type": "string", "pattern": "^(?!/)(?!\\\\)(?![^/]*:)(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+(?:/(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+)*#L[1-9][0-9]*-L[1-9][0-9]*$", "maxLength": 4096},
        {"type": "string", "pattern": "^git:[0-9a-f]{40}:(?!/)(?!\\\\)(?![^/]*:)(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+(?:/(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+)*#L[1-9][0-9]*-L[1-9][0-9]*$", "maxLength": 4096},
        {"type": "string", "pattern": "^arxiv:[0-9]{4}\\.[0-9]{4,5}v[1-9][0-9]*:(?!/)(?!\\\\)(?![^/]*:)(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+(?:/(?!\\.\\.?$)(?!\\.\\.?/)[A-Za-z0-9._-]+)*#L[1-9][0-9]*-L[1-9][0-9]*$", "maxLength": 4096}
      ]
    },
    "modules": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/module"}},
    "modulesMaybeEmpty": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/module"}},
    "routeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "manifest_path", "manifest_sha256", "receipt_path", "receipt_sha256"],
      "properties": {
        "route_id": {"enum": ["jin", "lorist-schwenninger", "harp"]},
        "manifest_path": {"$ref": "#/$defs/path"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_path": {"$ref": "#/$defs/path"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "role", "declaration", "module_path", "dependency_ids", "provenance_kind", "correspondence_kind", "source_locator", "source_archive_sha256", "source_file_sha256", "source_excerpt_sha256", "source_line_count", "reused_from_route", "reused_node_id", "declaration_type_path", "statement_sha256"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "role": {"enum": ["load-bearing", "terminal", "consequence"]},
        "declaration": {"$ref": "#/$defs/module"},
        "module_path": {"$ref": "#/$defs/path"},
        "dependency_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}},
        "provenance_kind": {"enum": ["source", "shared-foundation", "reused-route", "derived"]},
        "correspondence_kind": {"enum": ["direct-source", "compatibility-port", "structural-refactor", "derived-extraction", "shared-foundation", "reused-route"]},
        "source_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]},
        "source_archive_sha256": {"$ref": "#/$defs/nullableSha256"},
        "source_file_sha256": {"$ref": "#/$defs/nullableSha256"},
        "source_excerpt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "source_line_count": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "reused_from_route": {"oneOf": [{"type": "null"}, {"enum": ["jin", "lorist-schwenninger", "harp"]}]},
        "reused_node_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}]},
        "declaration_type_path": {"$ref": "#/$defs/path"},
        "statement_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"properties": {"provenance_kind": {"const": "source"}}, "required": ["provenance_kind"]}, "then": {"properties": {"correspondence_kind": {"enum": ["direct-source", "compatibility-port", "structural-refactor"]}}}},
        {"if": {"properties": {"provenance_kind": {"const": "derived"}}, "required": ["provenance_kind"]}, "then": {"properties": {"correspondence_kind": {"const": "derived-extraction"}}}},
        {"if": {"properties": {"provenance_kind": {"const": "shared-foundation"}}, "required": ["provenance_kind"]}, "then": {"properties": {"correspondence_kind": {"const": "shared-foundation"}}}},
        {"if": {"properties": {"provenance_kind": {"const": "reused-route"}}, "required": ["provenance_kind"]}, "then": {"properties": {"correspondence_kind": {"const": "reused-route"}}}},
        {"if": {"properties": {"provenance_kind": {"const": "source"}}, "required": ["provenance_kind"]}, "then": {"properties": {"source_locator": {"$ref": "#/$defs/locator"}, "source_file_sha256": {"$ref": "#/$defs/sha256"}, "source_excerpt_sha256": {"$ref": "#/$defs/sha256"}, "source_line_count": {"type": "integer", "minimum": 1}, "reused_from_route": {"type": "null"}, "reused_node_id": {"type": "null"}}}},
        {"if": {"properties": {"source_locator": {"type": "string", "pattern": "^(?:git:|arxiv:)"}}, "required": ["source_locator"]}, "then": {"properties": {"source_archive_sha256": {"$ref": "#/$defs/sha256"}}}},
        {"if": {"properties": {"source_locator": {"type": "string", "pattern": "^(?!(?:git:|arxiv:))"}}, "required": ["source_locator"]}, "then": {"properties": {"source_archive_sha256": {"type": "null"}}}},
        {"if": {"properties": {"provenance_kind": {"const": "reused-route"}}, "required": ["provenance_kind"]}, "then": {"properties": {"source_locator": {"type": "null"}, "source_archive_sha256": {"type": "null"}, "source_file_sha256": {"type": "null"}, "source_excerpt_sha256": {"type": "null"}, "source_line_count": {"type": "null"}, "reused_from_route": {"enum": ["jin", "lorist-schwenninger", "harp"]}, "reused_node_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}]}}}},
        {"if": {"properties": {"provenance_kind": {"enum": ["shared-foundation", "derived"]}}, "required": ["provenance_kind"]}, "then": {"properties": {"source_locator": {"type": "null"}, "source_archive_sha256": {"type": "null"}, "source_file_sha256": {"type": "null"}, "source_excerpt_sha256": {"type": "null"}, "source_line_count": {"type": "null"}, "reused_from_route": {"type": "null"}, "reused_node_id": {"type": "null"}}}}
      ]
    }
  }
}
