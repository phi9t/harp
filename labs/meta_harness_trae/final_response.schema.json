{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harp Meta-Harness TRAE final response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {
      "const": "harp-meta-harness-trae-final/v1"
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "axis", "hypothesis"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^agents/[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.py$"
        },
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "base_system": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
