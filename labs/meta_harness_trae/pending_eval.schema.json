{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstream-compatible pending_eval.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "final_response.schema.json#/$defs/candidate"
      }
    }
  }
}
